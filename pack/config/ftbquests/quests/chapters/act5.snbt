			rewards: [{ id: "3644052BAEC0E204", type: "item", auto: "enabled", item: "thermal:machine_efficiency_augment", count: 2 }, { id: "641B4AE9E45958D9", type: "item", auto: "enabled", item: "thermal:rf_coil_xfer_augment", count: 4 }, { id: "59B96DB39912D9BF", type: "item", auto: "enabled", item: "thermal:upgrade_augment_2", count: 2 }, { id: "7CA2506A2D10F0A2", type: "item", auto: "enabled", item: "thermal:energy_cell" }, { id: "0E6936CB87F7A7C7", type: "stage", auto: "enabled", stage: "big_power" }, { id: "102FE9DFB12A2EF2", type: "command", auto: "enabled", command: "/tellraw @a [{\"text\":\"Tobin: \",\"color\":\"yellow\"},{\"text\":\"Twenty-five thousand, and the fuel line never moved. That's the town through next winter twice over.\",\"color\":\"white\",\"italic\":true}]", elevate_perms: true, silent: true }, { id: "78E84BFF9AC61D85", type: "toast", title: "Power for a Quarry", auto: "enabled", description: "Next: two Crafting CPUs and wireless across the whole town." }]
		}
