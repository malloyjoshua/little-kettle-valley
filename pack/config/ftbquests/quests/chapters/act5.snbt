			rewards: [{ id: "454F1FA193A90B27", type: "item", auto: "enabled", item: "quarryplus:pump_module" }, { id: "3CF5F11E60C660B6", type: "item", auto: "enabled", item: "quarryplus:filler_module" }, { id: "1B2E8715CAB919EE", type: "item", auto: "enabled", item: "quarryplus:exp_module" }, { id: "5AD02AAEE9C19974", type: "command", auto: "enabled", command: "/tellraw @a [{\"text\":\"Tobin: \",\"color\":\"yellow\"},{\"text\":\"Right. That's a town works, and I'm going to go and sit down.\",\"color\":\"white\",\"italic\":true}]", elevate_perms: true, silent: true }, { id: "3110076BF027270D", type: "toast", title: "The Shaft Sinks", auto: "enabled", description: "Next: 1,024 cobblestone from network stock to the granary." }]
		}
		{
			id: "77BA3AD249428FE7"
			title: "Deliver 1,024 Cobblestone to the Granary"
			subtitle: "The first load."
			icon: "minecraft:cobblestone"
			description: ["Bram: \"Rock into the box, box into the granary. That's a public works, not a hole in a hill.\"", "", "Pattern the quarry's output — cobble to the granary, ore to the Pulverizer, the rest to the void — then let one full cycle land: 1,024 cobblestone out of network stock into the granary. The quarry keeps running afterwards.", "", "Oda's shelves restock themselves off your network from now on, and she will check that they did."]
			x: 14.0d
			y: 0.0d
			dependencies: ["2BE39B0CA5A019ED", "714CBF3A1860EFA5"]
			hide_until_deps_complete: true
