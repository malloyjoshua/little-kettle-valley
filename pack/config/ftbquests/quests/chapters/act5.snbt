			rewards: [{ id: "5A213E54F68CB439", type: "item", auto: "enabled", item: "valley:feast_crate" }, { id: "4940B8750B74BBF2", type: "item", auto: "enabled", item: "handcrafted:blue_plate", count: 8 }, { id: "300D7320AEC45EE7", type: "item", auto: "enabled", item: "mcwfurnitures:oak_table", count: 4 }, { id: "06A5BA7CD0455143", type: "command", auto: "enabled", command: "/tellraw @a [{\"text\":\"Halden: \",\"color\":\"green\"},{\"text\":\"You cooked for eight people who all showed up. Josie managed that twice.\",\"color\":\"white\",\"italic\":true}]", elevate_perms: true, silent: true }, { id: "1AADE1D644ED638D", type: "item", auto: "enabled", item: "explorerscompass:explorerscompass" }, { id: "04DC0A18CF76D022", type: "toast", title: "Feast Crate stored", auto: "enabled", description: "Next: the boat. Your new compass is already set to the Cairn Chapel and the Drowned Lighthouse." }]
