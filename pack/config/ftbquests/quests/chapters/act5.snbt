			rewards: [{ id: "D5F19B7883D3FBC8", type: "command", command: "/playsound minecraft:block.bell.use master @a ~ ~ ~ 2 1", elevate_perms: true, silent: true }, { id: "A665D8CA84AB9BE9", type: "command", command: "/tellraw @a {\"text\":\"Pip rings it eleven times. Nobody stops him.\",\"color\":\"gold\",\"italic\":true}", elevate_perms: true, silent: true }, { id: "E62D82C72FB91D10", type: "item", item: "perfectplushies:duck_plushie" }, { id: "6F874CE97087D295", type: "item", item: "minecraft:copper_block", count: 8 }, { id: "FC57E4E18CD5C3FA", type: "toast", title: "The bell is up", description: "Next: the fortieth lamp, on the bare post at Josie's porch." }]
