			tasks: [{ id: "61CE636445199611", type: "item", item: "valley:scrip", count: 80L, consume_items: true }]
			rewards: [{ id: "FBA27B4443196090", type: "item", item: "valley:deed" }, { id: "4C10FE6AC4A725ED", type: "stage", stage: "works_deed" }, { id: "8C3A05E9119A01D1", type: "command", command: "/tellraw @a {\"text\":\"The residents vote. Bram signs as witness: 'Kettle Works. Town-held. Good.'\",\"color\":\"gold\"}", elevate_perms: true, silent: true }, { id: "BBB1C12D79E7228A", type: "command", command: "/playsound minecraft:block.note_block.bell master @a ~ ~ ~ 1 1", elevate_perms: true, silent: true }, { id: "8E641CB8847C7087", type: "toast", title: "The Works Deed", description: "Next: place the quarry on Tobin's site and power it." }]
		}
