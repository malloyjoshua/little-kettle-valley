		{
			id: "64ABC3E0D32A9056"
			title: "Standing: Trusted"
			subtitle: "Six of eight neighbours' stories closed."
			icon: "minecraft:emerald"
			description: ["Oda: \"I don't keep a book of who likes you. I keep a book of who you've finished a thing for. Six is the number.\"", "", "Finish six of the eight neighbours' story chains, in any order — each closes on its last hand-in. At six, Oda counts you a local and puts the Works Deed on her counter at 80 Scrip.", "", "You don't have to do anything here. It ticks itself when the sixth neighbour's story closes, and Oda will not be talked into rounding up."]
			x: 2.0d
			y: 2.2d
			dependencies: ["60D1AF5CC6C6414F"]
			shape: "diamond"
			size: 1.0d
			hide_details_until_startable: true
			invisible: true
			hide_dependency_lines: true
			hide_dependent_lines: true
			tasks: [{ id: "725A8709933258F2", type: "checkmark", title: "Six of eight neighbours' stories closed" }]
			rewards: [{ id: "078EA02B391899B7", type: "toast", title: "Standing: Trusted", auto: "enabled", description: "Next: 80 Scrip at Oda's counter buys the Works Deed. (Press T and type /valley check standing to see her count.)" }]
		}
		{
			id: "2FE67859CD152D29"
			title: "Buy the Works Deed at Oda's Counter"
			subtitle: "80 Scrip, and six of eight stories closed."
			icon: "valley:deed"
			description: ["Halden: \"Josie meant the Works to belong to whoever stayed. Nobody has argued about it in four years.\"", "", "Pay 80 Valley Scrip at Oda's counter. The second half is Standing: Trusted — six of the eight resident chains closed — and it locks itself open the moment the sixth one does.", "", "Eight neighbours, six needed: Wisp, Marnie, Halden, Pip, Bram, Tobin, Nella, Oda. Run /valley check standing for where you are.", "", "The Deed is yours: QuarryPlus becomes craftable, the residents vote, and Bram signs as witness."]
			x: 10.0d
			y: 0.8d
			dependencies: ["1AD7611960B0EDA4", "06824CC3F51032B9", "64ABC3E0D32A9056"]
			shape: "diamond"
			size: 1.25d
			hide_details_until_startable: true
			tasks: [{ id: "61CE636445199611", type: "item", item: "valley:scrip", count: 80L, consume_items: true }]
			rewards: [{ id: "7BA27B4443196090", type: "item", auto: "enabled", item: "valley:deed" }, { id: "4C10FE6AC4A725ED", type: "stage", auto: "enabled", stage: "works_deed" }, { id: "0C3A05E9119A01D1", type: "command", auto: "enabled", command: "/tellraw @a {\"text\":\"The residents vote. Bram signs as witness: 'Kettle Works. Town-held. Good.'\",\"color\":\"gold\"}", elevate_perms: true, silent: true }, { id: "7CC7DBF09FE43B09", type: "command", auto: "enabled", command: "/tellraw @a [{\"text\":\"Halden: \",\"color\":\"green\"},{\"text\":\"Eight names on this deed and not one of them hers. She would have been unbearable about it.\",\"italic\":true}]", elevate_perms: true, silent: true }, { id: "0FEFDECE8803C64D", type: "command", auto: "enabled", command: "/tellraw @a [{\"text\":\"Oda: \",\"color\":\"gold\"},{\"text\":\"If every one of us walked out tomorrow, the lights here would still be on come Thursday. Never been true before.\",\"italic\":true}]", elevate_perms: true, silent: true }, { id: "3BB1C12D79E7228A", type: "command", auto: "enabled", command: "/playsound minecraft:block.note_block.bell master @a ~ ~ ~ 1 1", elevate_perms: true, silent: true }, { id: "0E641CB8847C7087", type: "toast", title: "The Works Deed", auto: "enabled", description: "Next: place the quarry on Tobin's site and power it." }]
		}
		{
			id: "2BE39B0CA5A019ED"
			title: "Set the Quarry on the Marker and Switch It On"
			subtitle: "Flat against the marker, facing in."
			icon: "quarryplus:quarry"
			description: ["Tobin: \"Pad's cut, marker's typed, lane's live. Rig flat against the marker, facing in, and switch it on. I am extremely calm about this.\"", "", "Hold the QuarryPlus Quarry, set it flat against the Flexible Marker you already typed and facing in, and switch it on off the lane you already ran. It builds its own frame.", "", "The shaft sinks and the quarry runs. It is the biggest thing Tobin has ever been responsible for and he checks the gauge four times."]
			x: 12.0d
			y: 0.0d
