			rewards: [{ id: "E7E2E3049E14883A", type: "stage", stage: "town_provides" }, { id: "1F8A8C9D73FB2A3E", type: "command", command: "/tellraw @a [{\"text\":\"Oda: \",\"color\":\"gold\"},{\"text\":\"My shelves filled themselves overnight. I have written it in the ledger and I am watching it.\",\"color\":\"white\",\"italic\":true}]", elevate_perms: true, silent: true }, { id: "A1457A5853CDA41E", type: "item", item: "valley:scrip", count: 15 }, { id: "30FFE02692E88891", type: "toast", title: "Stage: town_provides", description: "Next: cast a bell from the quarry's own copper." }]
		}
		{
