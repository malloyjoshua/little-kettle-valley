			rewards: [{ id: "C54F1FA193A90B27", type: "item", item: "quarryplus:pump_module" }, { id: "BCF5F11E60C660B6", type: "item", item: "quarryplus:filler_module" }, { id: "1B2E8715CAB919EE", type: "item", item: "quarryplus:exp_module" }, { id: "5AD02AAEE9C19974", type: "command", command: "/tellraw @a [{\"text\":\"Tobin: \",\"color\":\"yellow\"},{\"text\":\"Right. That's a town works, and I'm going to go and sit down.\",\"color\":\"white\",\"italic\":true}]", elevate_perms: true, silent: true }, { id: "02EF458EE77AC89A", type: "toast", title: "Tobin's arc closes", description: "Next: 1,024 cobblestone from network stock to the granary." }]
