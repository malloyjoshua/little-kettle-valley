	subtitle: ["Second Spring, Year Two", "Re-found the town: finish the square, balance the books, and sink the quarry that pays for the next hundred years.", "Forty lamps. Fifteen people. One winter that nobody leaves."]
	quests: [
		{
			id: "60D1AF5CC6C6414F"
			title: "Sleep, Then Walk the Square With Marnie"
			subtitle: "Year two, and the noticeboard is longer."
			icon: "minecraft:oak_sapling"
			description: ["Marnie: \"Snow's still on the ridge and the square's still standing. Come on — I want you to see it in daylight.\"", "", "Sleep one night in your own bed after the Longest Night, then walk the square with Marnie.", "", "Year two opens on Nella's cold frame, Oda's counter and thirty bare tiles in the square, with Marnie's packet for them in your arms."]
			x: 0.0d
			y: -0.8d
			dependencies: ["78E6F9A263CA4B65"]
			shape: "hexagon"
			size: 1.5d
			hide_until_deps_complete: true
			hide_details_until_startable: true
			tasks: [{ id: "2FDFDD57A230B3B4", type: "checkmark", title: "A night slept and the square walked with Marnie" }]
			rewards: [{ id: "1E02C5F93CC2131B", type: "item", auto: "enabled", item: "thermal:tomato_seeds", count: 8 }, { id: "72506352F7F2FF57", type: "item", auto: "enabled", item: "thermal:strawberry_seeds", count: 8 }, { id: "6CDCE0A74FCAF290", type: "item", auto: "enabled", item: "thermal:bell_pepper_seeds", count: 8 }, { id: "369617DB91B83057", type: "item", auto: "enabled", item: "thermal:corn_seeds", count: 8 }, { id: "57855711D290CD6C", type: "item", auto: "enabled", item: "farmersdelight:cabbage_seeds", count: 8 }, { id: "18604BD7B6A8970A", type: "item", auto: "enabled", item: "supplementaries:flower_box", count: 8 }, { id: "219C5BF3688EBD49", type: "item", auto: "enabled", item: "supplementaries:candle_holder", count: 8 }, { id: "7D784E76B396CA0F", type: "item", auto: "enabled", item: "minecraft:lantern", count: 6 }, { id: "0028C63F4632C425", type: "item", auto: "enabled", item: "handcrafted:oak_bench", count: 4 }, { id: "6F0B3CBFD8EF047D", type: "item", auto: "enabled", item: "supplementaries:planter", count: 4 }, { id: "1418D59DA2CB87F4", type: "item", auto: "enabled", item: "ae2:quartz_glass", count: 16 }, { id: "208D2D9EF13425B0", type: "item", auto: "enabled", item: "minecraft:glowstone_dust", count: 16 }, { id: "15BF84879691A661", type: "stage", auto: "enabled", stage: "year_two" }, { id: "6635CCEDD5B623E6", type: "command", auto: "enabled", command: "/valley scene q76", elevate_perms: true, silent: true }, { id: "5DE104CABF325AA6", type: "command", auto: "enabled", command: "/tellraw @a [{\"text\":\"Marnie: \",\"color\":\"light_purple\"},{\"text\":\"The noticeboard's rewritten. Year two, and it's a longer list than last spring.\",\"color\":\"white\",\"italic\":true}]", elevate_perms: true, silent: true }, { id: "12F233DF06C5A82D", type: "toast", title: "Year Two, Longer List", auto: "enabled", description: "Next: glaze Nella's cold frame with 16 Vibrant Quartz Glass, then dress the square's thirty tiles. The quartz and glowstone came up with Marnie." }]
		}
		{
			id: "17BC7CABEC8874AB"
			title: "Glaze the Cold Frame and Grow Four Crops"
			subtitle: "Four crops with snow still on the ridge."
			icon: "thermal:tomato"
			description: ["Nella: \"Glass, and I'll have a tomato up before the snow's off the ridge. I'm not making a speech about it.\"", "", "Glaze Nella's cold frame with 16 Vibrant Quartz Glass, then grow a Tomato, a Strawberry, a Bell Pepper and a Corn under it.", "", "2 dust, 2 Quartz Glass, 1 Cyanite Ingot makes two panes — eight crafts. Marnie brought the dust and glass; the reactor makes the cyanite.", "", "It glows on its own, so nothing under that frame ever needs a lantern. Hold all four crops at once when you hand this in.", "", "Nella takes the gardener's job. Marnie eats the first tomato standing in the doorway and says nothing about it."]
			x: 2.0d
			y: -2.2d
			dependencies: ["60D1AF5CC6C6414F", "13FC9DEDA582A29C"]
			shape: "circle"
			size: 1.25d
			hide_until_deps_complete: true
			hide_details_until_startable: true
			tasks: [{ id: "0D9CDACB7F94281E", type: "checkmark", title: "Cold frame glazed with 16 Vibrant Quartz Glass" }, { id: "0AEC7C22347980A7", type: "item", item: "thermal:tomato", count: 1L }, { id: "4C98319C8FFEB348", type: "item", item: "thermal:strawberry", count: 1L }, { id: "1120F7F24A4B6F91", type: "item", item: "thermal:bell_pepper", count: 1L }, { id: "5E7F5DD13D1FBDA2", type: "item", item: "thermal:corn", count: 1L }]
			rewards: [{ id: "658C37527ED95451", type: "item", auto: "enabled", item: "valley:winter_tomato" }, { id: "33490DA051CC8194", type: "item", auto: "enabled", item: "aquaculture:neptunium_fishing_rod" }, { id: "334132E3558EBB0F", type: "item", auto: "enabled", item: "aquaculture:worm", count: 32 }, { id: "20FF865173CCCB86", type: "item", auto: "enabled", item: "minecraft:glow_berries", count: 16 }, { id: "18CE0B86083C35AD", type: "item", auto: "enabled", item: "supplementaries:planter", count: 6 }, { id: "199B2D3B72C21DB4", type: "item", auto: "enabled", item: "valley:scrip", count: 25 }, { id: "66F22A800D4482DA", type: "loot", auto: "enabled", table_id: 6428311738069300697L }, { id: "3092F7F96E32E4FB", type: "command", auto: "enabled", command: "/tellraw @a [{\"text\":\"Nella: \",\"color\":\"aqua\"},{\"text\":\"I'll take the gardener's job. Don't tell Pip, he'll shout.\",\"color\":\"white\",\"italic\":true}]", elevate_perms: true, silent: true }, { id: "6B9CF6CA340F69FF", type: "toast", title: "The Gardener's Job", auto: "enabled", description: "Next: the derby — six fish for the inn wall." }, { id: "423D8C4ED745C493", type: "command", auto: "enabled", command: "/valley standing q77 {team}", elevate_perms: true, silent: true }]
		}
		{
			id: "6AEB1A84451F29C0"
			title: "Dress the Square's 30 Copper Tiles"
			subtitle: "The square stops looking like a building site."
			icon: "supplementaries:flower_box"
			description: ["Oda: \"Thirty tiles, thirty things. I have a preferred order — ignore me.\"", "", "Place one item on each of the 30 marked copper tiles in the square — 8 Flower Boxes, 8 Candle Holders, 6 Lanterns, 4 Oak Benches and 4 Planters, all of it out of Marnie's packet. Any order is right.", "", "Oda's full catalogue goes free at her counter, and the square is finished."]
			x: 2.0d
			y: -0.8d
			dependencies: ["60D1AF5CC6C6414F"]
			hide_until_deps_complete: true
			hide_details_until_startable: true
			tasks: [{ id: "41F6D61DD2D5B621", type: "checkmark", title: "Something on each of the 30 marked copper tiles" }]
			rewards: [{ id: "0B31CC9AD0282C7B", type: "item", auto: "enabled", item: "valley:framed_town_map" }, { id: "1F3F97F677BCAFF8", type: "item", auto: "enabled", item: "supplementaries:candle_holder", count: 8 }, { id: "6BB856B2FF926405", type: "item", auto: "enabled", item: "handcrafted:blue_plate", count: 4 }, { id: "4BE3F630F11078D7", type: "stage", auto: "enabled", stage: "square_finished" }, { id: "5CFA60B887E03995", type: "command", auto: "enabled", command: "/tellraw @a [{\"text\":\"Oda: \",\"color\":\"gold\"},{\"text\":\"Catalogue's free to you from today. I'll still have opinions.\",\"color\":\"white\",\"italic\":true}]", elevate_perms: true, silent: true }, { id: "2F47C4ECAF2B8A79", type: "toast", title: "The square is finished", auto: "enabled", description: "Next: the bell post is the only bare thing left. Cook eight dinners first." }]
		}
		{
			id: "10F1FDE5B519272D"
			title: "Catch Three Named Fish for the Inn Wall"
			subtitle: "Bluegill and perch by day, catfish after dark."
			icon: "aquaculture:oak_fish_mount"
			description: ["Nella: \"Bluegill and perch off the pier any time. Catfish is a night fish and he wants a worm on the hook.\"", "", "Catch one Bluegill, one Perch and one Catfish off the pier — the first two in daylight, the catfish after dark on a worm — then hang three of the four Fish Mounts Nella sent you. If he won't come up, he is in the deep water off the reeds.", "", "Fifty Scrip toward the winter debt, and three fish looking down at the long table."]
			x: 4.0d
			y: -1.5d
			dependencies: ["17BC7CABEC8874AB"]
			hide_until_deps_complete: true
			hide_details_until_startable: true
