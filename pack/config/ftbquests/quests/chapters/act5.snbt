		{
			id: "17BC7CABEC8874AB"
			title: "Glaze the Cold Frame and Grow Four Crops"
			subtitle: "Four crops with snow still on the ridge."
			icon: "thermal:tomato"
			description: ["Nella: \"Glass, and I'll have a tomato up before the snow's off the ridge. I'm not making a speech about it.\"", "", "Glaze the cold frame with 16 &aVibrant Quartz Glass&r, then grow a tomato, a strawberry, a bell pepper and a corn under it.", "", "2 glowstone dust, 2 quartz glass and 1 cyanite ingot make two panes: eight crafts. The glass lights itself, so nothing under that frame needs a lantern."]
			x: 2.0d
			y: -2.2d
			dependencies: ["60D1AF5CC6C6414F", "13FC9DEDA582A29C"]
			shape: "square"
			size: 1.0d
			hide_until_deps_complete: false
			hide_details_until_startable: false
			tasks: [{ id: "0D9CDACB7F94281E", type: "checkmark", title: "Cold frame glazed with 16 Vibrant Quartz Glass" }, { id: "0AEC7C22347980A7", type: "item", item: "thermal:tomato", count: 1L }, { id: "4C98319C8FFEB348", type: "item", item: "thermal:strawberry", count: 1L }, { id: "1120F7F24A4B6F91", type: "item", item: "thermal:bell_pepper", count: 1L }, { id: "5E7F5DD13D1FBDA2", type: "item", item: "thermal:corn", count: 1L }]
			rewards: [{ id: "658C37527ED95451", type: "item", auto: "no_toast", item: "valley:winter_tomato" }, { id: "33490DA051CC8194", type: "item", auto: "no_toast", item: "aquaculture:neptunium_fishing_rod" }, { id: "334132E3558EBB0F", type: "item", auto: "no_toast", item: "aquaculture:worm", count: 32 }, { id: "20FF865173CCCB86", type: "item", auto: "no_toast", item: "minecraft:glow_berries", count: 16 }, { id: "18CE0B86083C35AD", type: "item", auto: "no_toast", item: "supplementaries:planter", count: 6 }, { id: "199B2D3B72C21DB4", type: "item", auto: "no_toast", item: "valley:scrip", count: 25 }, { id: "66F22A800D4482DA", type: "loot", auto: "no_toast", table_id: 6428311738069300697L }, { id: "3092F7F96E32E4FB", type: "command", auto: "invisible", command: "/tellraw @a [{\"text\":\"Nella: \",\"color\":\"aqua\"},{\"text\":\"I'll take the gardener's job. Don't tell Pip, he'll shout.\",\"color\":\"white\",\"italic\":true}]", elevate_perms: true, silent: true }, { id: "423D8C4ED745C493", type: "command", auto: "invisible", command: "/valley standing q77 {team}", elevate_perms: true, silent: true }, { id: "5D6FFDBCB68E358E", type: "xp_levels", auto: "no_toast", xp_levels: 2 }, { id: "7466EE339DDD103F", type: "toast", title: "The Gardener's Job", auto: "enabled", description: "Next: three named fish off the pier for the inn wall." }]
		}
		{
			id: "6AEB1A84451F29C0"
			title: "Dress the Square's 30 Copper Tiles"
			subtitle: "The square stops looking like a building site."
			icon: "supplementaries:flower_box"
			description: ["Oda: \"Thirty tiles, thirty things. I have a preferred order. Ignore me.\"", "", "Put one thing on each of the &a30 marked copper tiles&r: 8 flower boxes, 8 candle holders, 6 lanterns, 4 oak benches, 4 planters. Any order is right.", "", "All of it came out of Marnie's packet. Oda's whole catalogue goes free at her counter and the square is finished."]
