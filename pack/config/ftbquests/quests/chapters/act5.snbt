			rewards: [{ id: "5FD99D1E9A1BB1A6", type: "item", auto: "enabled", item: "aquaculture:oak_fish_mount", count: 3 }, { id: "4C9D4F13C83FEF6D", type: "item", auto: "enabled", item: "perfectplushies:seal_plushie" }, { id: "6AB93D0204B19243", type: "item", auto: "enabled", item: "aquaculture:worm", count: 32 }, { id: "04B725A84F98DE7B", type: "item", auto: "enabled", item: "valley:scrip", count: 50 }, { id: "4A068E7315FD91CC", type: "toast", title: "Three on the wall", auto: "enabled", description: "Next: cook the eight dinners, then 120 Scrip at Oda's counter clears the winter debt." }]
		}
		{
			id: "014CC7D8367039B1"
			title: "Build the Second Turbine"
			subtitle: "Same reactor. Same fuel. Twice the power."
			icon: "biggerreactors:turbine_rotor_blade"
			description: ["Tobin: \"Second turbine, same reactor, and the fuel line does not move. I did the arithmetic four times, then once more with Bram watching.\"", "", "Build a second turbine off the reactor you already have, then stand at the reactor terminal, press T and type /valley check power. It ticks this quest when both turbines make 25,000 or more on 60 or less fuel.", "", "Enough power to sink a quarry, and nothing else in the valley needs this much."]
			x: 0.0d
			y: 0.8d
			dependencies: ["78E6F9A263CA4B65"]
			hide_until_deps_complete: true
			hide_details_until_startable: true
