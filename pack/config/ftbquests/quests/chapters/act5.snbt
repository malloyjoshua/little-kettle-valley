		}
		{
			id: "1AD7611960B0EDA4"
			title: "Pay 120 Valley Scrip at Oda's Counter"
			subtitle: "Eleven years of red ink, cleared."
			icon: "valley:scrip"
			description: ["Oda: \"Eleven years, and here — you hold the ledger. I've held it long enough.\"", "", "Hand 120 Valley Scrip across Oda's counter to clear the town's winter debt.", "", "The books balance for the first time since Josie, and 25 Scrip comes straight back across the counter."]
