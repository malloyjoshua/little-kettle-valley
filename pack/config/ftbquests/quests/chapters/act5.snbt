	subtitle: ["Second Spring, Year Two", "Re-found the town: finish the square, balance the books, and sink the quarry that pays for the next hundred years.", "Forty lamps. Fifteen people. One winter that nobody leaves."]
	quests: [
		{
			id: "E0D1AF5CC6C6414F"
			title: "Sleep One Night, Then Walk the Square With Marnie"
			subtitle: "Year two."
			icon: "minecraft:oak_sapling"
			description: ["Marnie: \"Snow's still on the ridge and the square's still standing. Come on — I want you to see it in daylight.\"", "", "Sleep one night in your own bed after the Longest Night, then walk the square with Marnie.", "", "Opens year two: Nella's cold frame, Oda's counter, and the thirty tiles of the square. The dressing packet for those tiles is in this quest's rewards."]
			x: 0.0d
			y: -0.8d
			dependencies: ["78E6F9A263CA4B65"]
			shape: "hexagon"
			size: 1.5d
			hide_until_deps_complete: true
			hide_details_until_startable: true
			tasks: [{ id: "4178EF8BDD8E6232", type: "checkmark", title: "Slept one night after the Longest Night, then walked the square with Marnie" }]
			rewards: [{ id: "9E02C5F93CC2131B", type: "item", item: "thermal:tomato_seeds", count: 8 }, { id: "72506352F7F2FF57", type: "item", item: "thermal:strawberry_seeds", count: 8 }, { id: "ECDCE0A74FCAF290", type: "item", item: "thermal:bell_pepper_seeds", count: 8 }, { id: "369617DB91B83057", type: "item", item: "thermal:corn_seeds", count: 8 }, { id: "57855711D290CD6C", type: "item", item: "farmersdelight:cabbage_seeds", count: 8 }, { id: "98604BD7B6A8970A", type: "item", item: "supplementaries:flower_box", count: 8 }, { id: "A19C5BF3688EBD49", type: "item", item: "supplementaries:candle_holder", count: 8 }, { id: "7D784E76B396CA0F", type: "item", item: "minecraft:lantern", count: 6 }, { id: "8028C63F4632C425", type: "item", item: "handcrafted:oak_bench", count: 4 }, { id: "6F0B3CBFD8EF047D", type: "item", item: "supplementaries:planter", count: 4 }, { id: "95BF84879691A661", type: "stage", stage: "year_two" }, { id: "DDE104CABF325AA6", type: "command", command: "/tellraw @a [{\"text\":\"Marnie: \",\"color\":\"light_purple\"},{\"text\":\"The noticeboard's rewritten. Year two, and it's a longer list than last spring.\",\"color\":\"white\",\"italic\":true}]", elevate_perms: true, silent: true }, { id: "A421183957AAE9EB", type: "toast", title: "Year two", description: "Next: glaze Nella's cold frame with 16 Tinted Glass — and the square's thirty marked copper tiles, from the packet in this payout." }]
		}
		{
			id: "97BC7CABEC8874AB"
			title: "Glaze the Cold Frame and Grow Four Crops Out of Season"
			subtitle: "Nella's chain closes."
			icon: "thermal:tomato"
			description: ["Nella: \"Glass, and I grew a tomato before the snow was off the ridge. I'm not making a speech about it.\"", "", "Glaze Nella's cold frame with 16 panes of greenhouse glass — in this valley that is Tinted Glass: two amethyst shards, one glass and one Cyanite Ingot makes two, so 16 shards and 8 cyanite. Cyanite comes out of the reactor; the amethyst is the geode the Works waystone stands over. Then grow and hold one Tomato, one Strawberry, one Bell Pepper and one Corn at the same time.", "", "Nella takes the gardener's job and her chain closes. Marnie eats the first tomato standing in the doorway and says nothing about it."]
			x: 2.0d
			y: -2.2d
			dependencies: ["E0D1AF5CC6C6414F", "93FC9DEDA582A29C"]
			shape: "circle"
			size: 1.25d
			hide_until_deps_complete: true
			hide_details_until_startable: true
			tasks: [{ id: "9DA1DE63E7DB1F9A", type: "checkmark", title: "Cold frame glazed with 16 Greenhouse Glass" }, { id: "8AEC7C22347980A7", type: "item", item: "thermal:tomato", count: 1L }, { id: "CC98319C8FFEB348", type: "item", item: "thermal:strawberry", count: 1L }, { id: "9120F7F24A4B6F91", type: "item", item: "thermal:bell_pepper", count: 1L }, { id: "DE7F5DD13D1FBDA2", type: "item", item: "thermal:corn", count: 1L }]
			rewards: [{ id: "E58C37527ED95451", type: "item", item: "valley:winter_tomato" }, { id: "33490DA051CC8194", type: "item", item: "aquaculture:neptunium_fishing_rod" }, { id: "B34132E3558EBB0F", type: "item", item: "aquaculture:worm", count: 32 }, { id: "A0FF865173CCCB86", type: "item", item: "minecraft:glow_berries", count: 16 }, { id: "18CE0B86083C35AD", type: "item", item: "supplementaries:planter", count: 6 }, { id: "199B2D3B72C21DB4", type: "item", item: "valley:scrip", count: 25 }, { id: "66F22A800D4482DA", type: "loot", table_id: 6428311738069300697L }, { id: "3092F7F96E32E4FB", type: "command", command: "/tellraw @a [{\"text\":\"Nella: \",\"color\":\"aqua\"},{\"text\":\"I'll take the gardener's job. Don't tell Pip, he'll shout.\",\"color\":\"white\",\"italic\":true}]", elevate_perms: true, silent: true }, { id: "2C6BC621F923DACC", type: "toast", title: "Nella's chain closes", description: "Next: the derby — six fish for the inn wall." }, { id: "2A6F230F0886809C", type: "command", command: "/valley standing q77 {long_team_id}", elevate_perms: true, silent: true }]
		}
		{
			id: "EAEB1A84451F29C0"
			title: "Put One Item on Each of the 30 Marked Copper Tiles"
			subtitle: "Any order is right."
			icon: "supplementaries:flower_box"
			description: ["Oda: \"Thirty tiles, thirty things. I have a preferred order — ignore me.\"", "", "Place one item on each of the 30 marked copper tiles in the square. Everything came in Marnie's packet: 8 Flower Boxes, 8 Candle Holders, 6 Lanterns, 4 Oak Benches, 4 Planters. Any order is right.", "", "Oda's full catalogue goes free at her counter, and the square is finished."]
			x: 2.0d
			y: -0.8d
			dependencies: ["E0D1AF5CC6C6414F"]
			hide_until_deps_complete: true
			hide_details_until_startable: true
			tasks: [{ id: "A4AF56435510ACE3", type: "checkmark", title: "All 30 marked copper tiles in the square have something on them" }]
			rewards: [{ id: "0B31CC9AD0282C7B", type: "item", item: "valley:framed_town_map" }, { id: "9F3F97F677BCAFF8", type: "item", item: "supplementaries:candle_holder", count: 8 }, { id: "6BB856B2FF926405", type: "item", item: "handcrafted:blue_plate", count: 4 }, { id: "CBE3F630F11078D7", type: "stage", stage: "square_finished" }, { id: "5CFA60B887E03995", type: "command", command: "/tellraw @a [{\"text\":\"Oda: \",\"color\":\"gold\"},{\"text\":\"Catalogue's free to you from today. I'll still have opinions.\",\"color\":\"white\",\"italic\":true}]", elevate_perms: true, silent: true }, { id: "2F47C4ECAF2B8A79", type: "toast", title: "The square is finished", description: "Next: the bell post is the only bare thing left. Cook eight dinners first." }]
		}
		{
			id: "10F1FDE5B519272D"
			title: "Catch Six Named Fish and Hang Three Mounts on the Inn Wall"
			subtitle: "The Fishing Derby."
			icon: "aquaculture:oak_fish_mount"
			description: ["Nella: \"Bluegill and perch off the pier any time. Trout and pike in the cold water past the reeds; catfish and carp are night fish and they want a worm.\"", "", "Catch one Bluegill, one Perch, one Brown Trout, one Muskellunge (that's the pike), one Catfish and one Carp — the worm box in your bag holds thirty-two. If a species will not come, move one bank up the river; the water changes temperature there. Then hang three of your Oak Fish Mounts on the inn wall.", "", "Pays 50 Valley Scrip toward the town's winter debt."]
			x: 4.0d
			y: -0.8d
			dependencies: ["97BC7CABEC8874AB"]
			hide_until_deps_complete: true
			hide_details_until_startable: true
			tasks: [{ id: "DC0DE7E7E20C3C4F", type: "item", item: "aquaculture:bluegill", count: 1L }, { id: "342706114A291648", type: "item", item: "aquaculture:perch", count: 1L }, { id: "73582E85005AEC1F", type: "item", item: "aquaculture:brown_trout", count: 1L }, { id: "B42E780EECBF8C8D", type: "item", item: "aquaculture:muskellunge", count: 1L }, { id: "45A6B91F118E4CCE", type: "item", item: "aquaculture:catfish", count: 1L }, { id: "44B518A11E10DD78", type: "item", item: "aquaculture:carp", count: 1L }, { id: "8ADC48890EC7448C", type: "item", item: "aquaculture:oak_fish_mount", count: 3L }]
			rewards: [{ id: "DFD99D1E9A1BB1A6", type: "item", item: "aquaculture:oak_fish_mount", count: 3 }, { id: "CC9D4F13C83FEF6D", type: "item", item: "perfectplushies:seal_plushie" }, { id: "EAB93D0204B19243", type: "item", item: "aquaculture:worm", count: 32 }, { id: "84B725A84F98DE7B", type: "item", item: "valley:scrip", count: 50 }, { id: "318574B553F58978", type: "toast", title: "Six on the wall", description: "Next: cook the eight dinners, then 120 Scrip at Oda's counter clears the winter debt." }]
		}
		{
			id: "014CC7D8367039B1"
			title: "Hit 25,000 FE/t Across Both Turbines Without Passing 60 mB/t of Fuel"
			subtitle: "A problem, not a recipe."
			icon: "biggerreactors:turbine_rotor_blade"
			description: ["Tobin: \"Second turbine, same reactor, and the fuel line does not move. I did the arithmetic four times, then once more with Bram watching.\"", "", "Build a second turbine off the reactor and hold 25,000 FE/t summed across both turbine terminals, while the reactor's fuel burn stays at or under 60 mB/t of yellorium. Steam is free; fuel is the budget. Tobin's signed figures are on the Turbine page in your journal — eighteen hundred under load, and the burn he wrote under it. Run /valley check power at the reactor terminal; it prints both numbers and ticks this quest.", "", "Stage big_power. The quarry runs off this and nothing else does."]
			x: 0.0d
			y: 0.8d
			dependencies: ["78E6F9A263CA4B65"]
			hide_until_deps_complete: true
			hide_details_until_startable: true
			tasks: [{ id: "727EF0096BE47A58", type: "checkmark", title: "25,000 FE/t sustained across both turbines at 60 mB/t fuel burn or under (/valley check power)" }]
			rewards: [{ id: "3644052BAEC0E204", type: "item", item: "thermal:machine_efficiency_augment", count: 2 }, { id: "E41B4AE9E45958D9", type: "item", item: "thermal:rf_coil_xfer_augment", count: 4 }, { id: "59B96DB39912D9BF", type: "item", item: "thermal:upgrade_augment_2", count: 2 }, { id: "7CA2506A2D10F0A2", type: "item", item: "thermal:energy_cell" }, { id: "0E6936CB87F7A7C7", type: "stage", stage: "big_power" }, { id: "102FE9DFB12A2EF2", type: "command", command: "/tellraw @a [{\"text\":\"Tobin: \",\"color\":\"yellow\"},{\"text\":\"Twenty-five thousand, and the fuel line never moved. That's the town through next winter twice over.\",\"color\":\"white\",\"italic\":true}]", elevate_perms: true, silent: true }, { id: "B55B97736553656F", type: "toast", title: "Stage: big_power", description: "Next: two Crafting CPUs and wireless across the whole town." }]
		}
