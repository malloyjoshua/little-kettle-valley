		}
		{
			id: "97BC7CABEC8874AB"
			title: "Glaze the Cold Frame and Grow Four Crops Out of Season"
			subtitle: "Nella's chain closes."
			icon: "thermal:tomato"
			description: ["Nella: \"Glass, and I grew a tomato before the snow was off the ridge. I'm not making a speech about it.\"", "", "Glaze Nella's cold frame with 16 panes of greenhouse glass — in this valley that is Vibrant Quartz Glass: 2 glowstone dust, 2 Quartz Glass and 1 Cyanite Ingot makes 2 panes, so 8 crafts for the 16. The glass and the glowstone came with Marnie's walk round the square; the cyanite comes out of the reactor. It glows, so the frame lights itself and nothing under it needs a lantern. Then grow and hold one Tomato, one Strawberry, one Bell Pepper and one Corn at the same time.", "", "Nella takes the gardener's job and her chain closes. Marnie eats the first tomato standing in the doorway and says nothing about it."]
			x: 2.0d
			y: -2.2d
			dependencies: ["E0D1AF5CC6C6414F", "93FC9DEDA582A29C"]
			shape: "circle"
			size: 1.25d
			hide_until_deps_complete: true
			hide_details_until_startable: true
			tasks: [{ id: "8D9CDACB7F94281E", type: "checkmark", title: "Cold frame glazed with 16 Vibrant Quartz Glass" }, { id: "8AEC7C22347980A7", type: "item", item: "thermal:tomato", count: 1L }, { id: "CC98319C8FFEB348", type: "item", item: "thermal:strawberry", count: 1L }, { id: "9120F7F24A4B6F91", type: "item", item: "thermal:bell_pepper", count: 1L }, { id: "DE7F5DD13D1FBDA2", type: "item", item: "thermal:corn", count: 1L }]
			rewards: [{ id: "E58C37527ED95451", type: "item", item: "valley:winter_tomato" }, { id: "33490DA051CC8194", type: "item", item: "aquaculture:neptunium_fishing_rod" }, { id: "B34132E3558EBB0F", type: "item", item: "aquaculture:worm", count: 32 }, { id: "A0FF865173CCCB86", type: "item", item: "minecraft:glow_berries", count: 16 }, { id: "18CE0B86083C35AD", type: "item", item: "supplementaries:planter", count: 6 }, { id: "199B2D3B72C21DB4", type: "item", item: "valley:scrip", count: 25 }, { id: "66F22A800D4482DA", type: "loot", table_id: 6428311738069300697L }, { id: "3092F7F96E32E4FB", type: "command", command: "/tellraw @a [{\"text\":\"Nella: \",\"color\":\"aqua\"},{\"text\":\"I'll take the gardener's job. Don't tell Pip, he'll shout.\",\"color\":\"white\",\"italic\":true}]", elevate_perms: true, silent: true }, { id: "2C6BC621F923DACC", type: "toast", title: "Nella's chain closes", description: "Next: the derby — six fish for the inn wall." }, { id: "C23D8C4ED745C493", type: "command", command: "/valley standing q77 {team}", elevate_perms: true, silent: true }]
		}
