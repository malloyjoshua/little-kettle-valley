			rewards: [{ id: "E379AB5AEE5195A9", type: "item", item: "quarryplus:flex_marker" }, { id: "143C4372F0E19CC9", type: "item", item: "quarryplus:marker", count: 4 }, { id: "7C458A95E0AC015D", type: "item", item: "quarryplus:y_setter" }, { id: "4381F5C00808D8E1", type: "item", item: "thermal:energy_duct", count: 64 }, { id: "CB82A9E1B0DCA055", type: "item", item: "valley:scrip", count: 15 }, { id: "D641BD901429F823", type: "toast", title: "The Pad Is Cut", description: "Next: the Works Deed at Oda's counter — 80 Scrip and Standing: Trusted — and then the rig goes on the marker." }]
