		{
			id: "64ABC3E0D32A9056"
			title: "Standing: Trusted"
			subtitle: "Six of eight neighbours' stories closed."
			icon: "minecraft:emerald"
			description: ["Oda: \"I don't keep a book of who likes you. I keep a book of who you've finished a thing for. Six is the number.\"", "", "Standing is simply how many of the eight named residents' stories your team has finished: Wisp, Marnie, Halden, Pip, Bram, Tobin, Nella, Oda. At six, the valley considers you one of its own and Oda will sell you the Works Deed.", "", "This card is never drawn in the book. A KubeJS listener ticks it the moment the sixth chain closes. Run /valley check standing to see the count."]
			x: 2.0d
			y: 2.2d
			dependencies: ["E0D1AF5CC6C6414F"]
			shape: "diamond"
			size: 1.0d
			hide_details_until_startable: true
			invisible: true
			hide_dependency_lines: true
			hide_dependent_lines: true
			tasks: [{ id: "F25A8709933258F2", type: "checkmark", title: "Six of eight neighbours' stories closed" }]
			rewards: [{ id: "6503F1272395159F", type: "toast", title: "Standing: Trusted", description: "Six of eight neighbours' stories are closed. Oda will sell you the Works Deed." }]
		}
		{
			id: "2FE67859CD152D29"
			title: "Buy the Works Deed: 80 Valley Scrip and Standing: Trusted"
			subtitle: "Six of eight chains closed."
			icon: "valley:deed"
			description: ["Halden: \"Josie meant the Works to belong to whoever stayed. Nobody has argued about it in four years.\"", "", "Pay 80 Valley Scrip at Oda's counter. The second half is Standing: Trusted — six of the eight resident chains closed — and it locks itself open the moment the sixth one does.", "", "Wisp's people came in off the ice · Marnie sat down at her own table · Halden's rounds · Pip's satchel · Bram's cocoa · Tobin's signature on the readings · Nella's tomato · Oda's ledger. Run /valley check standing for the count.", "", "The Deed is yours: QuarryPlus becomes craftable, the residents vote, and Bram signs as witness."]
			x: 10.0d
			y: 0.0d
			dependencies: ["9AD7611960B0EDA4", "86824CC3F51032B9", "64ABC3E0D32A9056"]
			shape: "diamond"
			size: 1.25d
			hide_details_until_startable: true
			tasks: [{ id: "61CE636445199611", type: "item", item: "valley:scrip", count: 80L, consume_items: true }]
			rewards: [{ id: "FBA27B4443196090", type: "item", item: "valley:deed" }, { id: "4C10FE6AC4A725ED", type: "stage", stage: "works_deed" }, { id: "8C3A05E9119A01D1", type: "command", command: "/tellraw @a {\"text\":\"The residents vote. Bram signs as witness: 'Kettle Works. Town-held. Good.'\",\"color\":\"gold\"}", elevate_perms: true, silent: true }, { id: "BBB1C12D79E7228A", type: "command", command: "/playsound minecraft:block.note_block.bell master @a ~ ~ ~ 1 1", elevate_perms: true, silent: true }, { id: "8E641CB8847C7087", type: "toast", title: "The Works Deed", description: "Next: place the quarry on Tobin's site and power it." }]
		}
		{
			id: "ABE39B0CA5A019ED"
			title: "Place the Quarry and 4 Markers on Tobin's Site and Power It"
			subtitle: "Tobin's arc closes."
			icon: "quarryplus:quarry"
			description: ["Tobin: \"Rig on my X, markers on the corners — or one Flexible Marker and type the box, which is quicker. Power off the reactor. I am extremely calm about this.\"", "", "Hold the QuarryPlus Quarry and 4 Markers, set them on the site the deep survey picked, and run power to the rig from the reactor.", "", "The shaft sinks and the quarry runs. It is the biggest thing Tobin has ever been responsible for, and his arc closes here."]
			x: 12.0d
