		{
			id: "014CC7D8367039B1"
			title: "Build the Second Turbine"
			subtitle: "Same reactor. Same fuel. Twice the power."
			icon: "biggerreactors:turbine_rotor_blade"
			description: ["Tobin: \"Second turbine, same reactor, and the fuel line does not move. I did the arithmetic four times, then once more with Bram watching.\"", "", "Build a second turbine off the reactor you already have, then stand at the terminal, press &bT&r and type &b/valley check power&r.", "", "It ticks at 25,000 or more on 60 or less fuel. Turbines start to finish: the &6Reactor & the Quarry&r chapter."]
			x: 0.0d
			y: 0.8d
			dependencies: ["78E6F9A263CA4B65"]
			shape: "hexagon"
			size: 1.5d
			hide_until_deps_complete: false
			hide_details_until_startable: false
			tasks: [{ id: "3FFA7CA37657EF8B", type: "checkmark", title: "Both turbines at 25,000+ on 60 or less fuel" }]
			rewards: [{ id: "3644052BAEC0E204", type: "item", auto: "no_toast", item: "thermal:machine_efficiency_augment", count: 2 }, { id: "641B4AE9E45958D9", type: "item", auto: "no_toast", item: "thermal:rf_coil_xfer_augment", count: 4 }, { id: "59B96DB39912D9BF", type: "item", auto: "no_toast", item: "thermal:upgrade_augment_2", count: 2 }, { id: "7CA2506A2D10F0A2", type: "item", auto: "no_toast", item: "thermal:energy_cell" }, { id: "0E6936CB87F7A7C7", type: "stage", auto: "invisible", stage: "big_power" }, { id: "102FE9DFB12A2EF2", type: "command", auto: "invisible", command: "/tellraw @a [{\"text\":\"Tobin: \",\"color\":\"yellow\"},{\"text\":\"Twenty-five thousand, and the fuel line never moved. That's the town through next winter twice over.\",\"color\":\"white\",\"italic\":true}]", elevate_perms: true, silent: true }, { id: "34B49E9192FFEB4E", type: "xp_levels", auto: "no_toast", xp_levels: 3 }, { id: "38CE8B5A7B727EBC", type: "toast", title: "Power For A Quarry", auto: "enabled", description: "Next: two 16k Crafting Storage and wireless across the whole town." }]
		}
