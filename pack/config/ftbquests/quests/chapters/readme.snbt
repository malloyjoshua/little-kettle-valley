			id: "787AFA21D03D8D95"
			title: "Order Barely Matters"
			subtitle: "Out of sequence is still the story."
			icon: "minecraft:oak_sign"
			description: ["A quest waits for the ones drawn into it and for nothing else.", "", "Mill the flour before the kitchen or the kitchen before the mill; both roads meet. Anything you walk past is still standing there next season, and no side branch you skip takes the story with it."]
			x: 2.0d
