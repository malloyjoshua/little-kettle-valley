			id: "1B3DB6FF772A17A1"
			title: "Nothing Here Is Timed"
			subtitle: "No clock, no fail state, no penalty."
			icon: "minecraft:clock"
			description: ["No quest in this pack has a timer, and none of them can be failed.", "", "Crops keep. Neighbours wait. The seasons turn on the calendar and not on you, and a quest left half done in spring is exactly where you left it in autumn."]
