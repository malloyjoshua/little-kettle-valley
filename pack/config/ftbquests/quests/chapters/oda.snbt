	subtitle: ["The Valley Scrip shop. Open from the moment the store reopens.", "Cozy work pays Scrip; Scrip deletes tech grind. Every buy line restocks.", "Stock arrives in tiers, and the tiers arrive on the rail line."]
	quests: [
		{
			id: "661864478A97F41E"
			title: "Read Oda's Board at the Counter"
			subtitle: "Scrip only. Every buy line restocks."
			icon: "valley:scrip"
			description: ["Oda: \"Store's open. Shelves are thin and my ledger is thinner, but they're open. Cash is Scrip. I don't barter and I don't round up.\"", "", "Scrip comes from deliveries, festival baskets and closing a neighbour's story. My standing order pays eight Scrip for twenty-four wheat, once, and then that page is closed. Nothing else pays it and nothing else spends it.", "", "Every buy line below restocks. Buy a line as many times as you can pay for it.", "", "One warning, and it's the only one I'll give: keep two hundred Scrip back. The town's winter debt is a hundred and twenty and the Works Deed is eighty, and both of those are mine to collect, and I will not be talked down. Spend whatever is over the two hundred on whatever you like — I sell nothing you actually need."]
			x: 0.0d
			y: 0.0d
			dependencies: ["1589859EB1A28DCE"]
			shape: "hexagon"
			size: 1.5d
			hide_until_deps_complete: true
			hide_details_until_startable: true
			tasks: [{ id: "47831093E5788B67", type: "checkmark", title: "Read the board and the prices under it" }]
			rewards: [{ id: "63897F04BEC3881B", type: "item", item: "valley:catalogue" }, { id: "27A2E446F0A125E1", type: "item", item: "valley:scrip", count: 10 }, { id: "49A42F43DD652389", type: "command", command: "/tellraw @p [{\"text\":\"Oda: \",\"color\":\"gold\"},{\"text\":\"Ten Scrip, on the house. That is the only time those three words happen in this store.\",\"color\":\"white\",\"italic\":true}]", elevate_perms: true, silent: true }, { id: "4341257E124AED00", type: "toast", title: "Oda's Counter is open", description: "Scrip only. Every buy line restocks. Cheap tech first, decor when the rail comes in — and keep 200 Scrip back for year two. Oda means it." }]
		}
		{
			id: "0FE8C79C42C61940"
			title: "Fill a Standing Order — 24 Wheat for 8 Scrip"
			subtitle: "8 Scrip. Once."
			icon: "minecraft:wheat"
			description: ["Oda: \"One standing order, filled once. After that the wheat goes on my shelf and the Scrip comes out of your work, not my ledger.\"", "", "Twenty-four wheat across the counter, eight Scrip back, one time. Every Scrip after this comes from deliveries, festival baskets and closing a neighbour's story."]
			x: 0.0d
			y: 3.0d
