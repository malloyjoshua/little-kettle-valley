	quests: [
		{
			id: "661864478A97F41E"
			title: "Read Oda's Board at the Counter"
			subtitle: "Scrip only. Every buy line restocks."
			icon: "valley:scrip"
			description: ["Oda: \"Store's open. Shelves are thin and my ledger is thinner, but they're open. Cash is Scrip. I don't barter and I don't round up.\"", "", "Buy anything on this board with Valley Scrip. Scrip comes from deliveries, festival baskets and closing a neighbour's story — her standing order pays eight for twenty-four wheat, once, and then that page is closed.", "", "Every buy line below restocks. Buy a line as many times as you can pay for it.", "", "One warning: keep two hundred Scrip back. The winter debt is a hundred and twenty, the Works Deed is eighty, and I do not get talked down.", "", "&7Two players:&r Scrip is one purse. Pile it into one pack before you buy — and before Oda asks for the hundred and twenty."]
			x: 0.0d
			y: 0.0d
			dependencies: ["1589859EB1A28DCE"]
			shape: "hexagon"
			size: 1.5d
			min_width: 300
			hide_until_deps_complete: false
			hide_details_until_startable: false
			tasks: [{ id: "47831093E5788B67", type: "checkmark", title: "Read the board and the prices under it" }]
			rewards: [{ id: "63897F04BEC3881B", type: "item", auto: "no_toast", item: "valley:catalogue" }, { id: "0746E47533614B28", type: "item", team_reward: true, auto: "no_toast", item: "valley:scrip", count: 10 }, { id: "374762EF82CB36F3", type: "command", team_reward: true, auto: "invisible", command: "/tellraw @p [{\"text\":\"Oda: \",\"color\":\"gold\"},{\"text\":\"Ten Scrip, on the house. That is the only time those three words happen in this store.\",\"color\":\"white\",\"italic\":true}]", elevate_perms: true, silent: true }, { id: "0E67C3B804FC8860", type: "xp_levels", auto: "no_toast", xp_levels: 1 }, { id: "445FD32D55DD1C5A", type: "toast", title: "Oda's Counter is open", auto: "enabled", description: "Next: buy the cheap tech now, the decor when the rail comes in — and keep 200 Scrip back for year two. Oda means it." }]
		}
		{
