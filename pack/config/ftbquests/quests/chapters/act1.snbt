		}
		{
			id: "167FBD502857379B"
			title: "Talk to Bram at the Broken Mill"
			subtitle: "Walk west to the mill. He will accept 'hold this'."
			icon: "valley:token_bram"
			description: ["Bram: \"I don't need help — I need somebody to hold things. Different word, same pair of hands.\"", "", "Walk to the mill plot marked on your map, talk to Bram, and bring back the Millwright's Bolt he puts in your hand.", "", "Bram opens his labelled crates: 12 iron ingots and 24 andesite — three times what eight alloys want, because the Millstone wants the rest."]
