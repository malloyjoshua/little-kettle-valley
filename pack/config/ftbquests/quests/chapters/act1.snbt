		{
			id: "22DF54626799495A"
			title: "Till and Plant the 3x9 Patch"
			subtitle: "Wheat, carrots, potatoes."
			icon: "minecraft:wheat_seeds"
			description: ["Marnie: \"Three beds: wheat, carrots, potatoes. Anything fancier and you'll be eating it alone in July.\"", "", "Till the 3x9 patch behind the house — every tile is marked in path blocks — then plant the 9 carrots, 9 potatoes and 9 wheat seeds from Marnie's sack. Do the wheat last: hand in holding the nine seeds, which the book counts and never takes.", "", "Marnie hands over the fence, the gate, the trough and three Hen Crates for the pen next to it."]
			x: 0.0d
			y: -1.5d
			dependencies: ["2CA1AF8451E957EA"]
