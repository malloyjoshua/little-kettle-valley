		{
			id: "7444A31B1FB2101C"
			title: "Take Bram's Wide Hammer Off the Bench"
			subtitle: "Three by three. One swing."
			icon: "justhammers:stone_hammer"
			description: ["Bram: \"Josie said this thing made a man lazy. Then she borrowed it for eleven days and gave it back with the handle worn smooth.\"", "", "Take the Stone Hammer off the peg by Bram's bench. It breaks a three-by-three face in one swing — every block in the square goes the same as the one in the middle — so aim the middle of the square at the middle of the hole you want.", "", "It is yours. Bram will not take it back and he will not discuss it further."]
			x: 4.0d
			y: 0.0d
			dependencies: ["70AF7E0ABE69FA26"]
			optional: true
			shape: "square"
			hide_until_deps_complete: false
			hide_details_until_startable: false
			tasks: [{ id: "1D4FF67AA7FE56D2", type: "checkmark", title: "Stone Hammer off the peg and in your bag" }]
			rewards: [{ id: "7AB11217DCF84DEA", type: "item", auto: "no_toast", item: "justhammers:stone_hammer" }, { id: "3C5244D7C84B9F19", type: "command", auto: "invisible", command: "/tellraw @a [{\"text\":\"Bram: \",\"color\":\"gray\"},{\"text\":\"Middle of the square, middle of the hole. And do not swing it in my mill.\",\"italic\":true}]", elevate_perms: true, silent: true }, { id: "7B1DDA1B97F1A0DE", type: "toast", title: "Bram's Wide Hammer", auto: "enabled", description: "Next: the Millstone and Hand Crank, and 16 flour for Marnie. The peg by Bram's bench is empty now and stays empty." }]
		}
		{
			id: "2F8AE9350986BEB5"
			title: "Read the Ground Behind the Cottage"
			subtitle: "Ore lives in beds, and the beds leave signs."
			icon: "geolosys:hematite_ore_sample"
			description: ["Bram: \"You'll not find iron by hitting stone and hoping. Nobody has, here, since Josie's day.\"", "Walk the grass behind the cottage and look for the small rust-brown rocks lying about: those are ore samples, and every one of them sits over a bed of iron thirty blocks down. Dig straight under the samples and bring back 8 iron clusters (hematite breaks into them). Bram's wide hammer takes it three blocks at a time.", "Every metal in the valley works this way: coal, copper, tin, silver, gold. Samples on the surface, the bed beneath. Tobin will teach you to read them properly in the summer."]
			x: 6.0d
			y: -0.8d
			dependencies: ["7444A31B1FB2101C"]
			hide_until_deps_complete: false
			hide_details_until_startable: false
