	quests: [
		{
			id: "22DF54626799495A"
			title: "Till and Plant the 3x9 Patch"
			subtitle: "Wheat, carrots, potatoes."
			icon: "minecraft:wheat_seeds"
			description: ["Marnie: \"Three beds: wheat, carrots, potatoes. Anything fancier and you'll be eating it alone in July.\"", "", "Take the &ahoe&r from your bag and right-click each of the 27 marked tiles behind the house, then plant &a9 carrots&r, &a9 potatoes&r and &a9 wheat seeds&r. Marnie packed a spare nine seeds for the hand-in; the book counts them and never takes them.", "", "For what grows in which season, see the &6Farm and Seasons&r chapter."]
			x: 0.0d
			y: -1.5d
			dependencies: ["2CA1AF8451E957EA"]
			shape: "hexagon"
			size: 2.0d
			hide_until_deps_complete: false
			hide_details_until_startable: false
			tasks: [{ id: "56EABBC35AFECBB7", type: "item", item: "minecraft:wheat_seeds", count: 9L }, { id: "09EE72E02C9F5215", type: "checkmark", title: "All 27 marked tiles tilled and planted" }]
			rewards: [{ id: "45D685BA2313E517", type: "item", auto: "no_toast", item: "thermal:watering_can" }, { id: "4854821CBCCED67F", type: "item", auto: "no_toast", item: "minecraft:bone_meal", count: 16 }, { id: "1AD64E7E765CF0BC", type: "item", auto: "no_toast", item: "vinery:straw_hat" }, { id: "0389C6180026B2E3", type: "item", auto: "no_toast", item: "farm_and_charm:scarecrow" }, { id: "163502DB627397E5", type: "item", auto: "no_toast", item: "minecraft:oak_fence", count: 24 }, { id: "0B57DF2F7CD391C6", type: "item", auto: "no_toast", item: "minecraft:oak_fence_gate" }, { id: "6FB58B75C3A8544D", type: "item", auto: "no_toast", item: "farm_and_charm:feeding_trough" }, { id: "61CD818FDAE83938", type: "item", auto: "no_toast", item: "valley:hen_crate", count: 3 }, { id: "700A422707F715AF", type: "xp_levels", auto: "no_toast", xp_levels: 2 }, { id: "0402B65F4F556718", type: "toast", title: "Three Beds of Dirt", auto: "enabled", description: "Next: fence the pen on the marked footings and open the three Hen Crates inside it." }]
		}
		{
			id: "0BFB18E2492D8F4D"
			title: "Fence the Pen and Open the Three Hen Crates"
			subtitle: "Two hens and a rooster."
			icon: "valley:hen_crate"
			description: ["Marnie: \"Two hens and a rooster. Don't name the rooster — you'll get attached, and he is horrible.\"", "", "Put a fence section on each of the 23 stone footings behind the house, hang the gate on the single grey slab in the middle of the side facing you, then right-click all three &aHen Crates&r inside the pen. Any order is right.", "", "A &aMegatorch&r goes up over the coop. Nothing hostile spawns inside its reach."]
			x: 2.0d
			y: -1.5d
			dependencies: ["22DF54626799495A"]
			shape: "square"
			size: 1.0d
			hide_until_deps_complete: false
			hide_details_until_startable: false
			tasks: [{ id: "69C20F4B1D1ED3C1", type: "checkmark", title: "Three chickens standing inside the finished pen" }]
			rewards: [{ id: "751DF2986D7640D3", type: "command", team_reward: true, auto: "invisible", command: "/valley scene coop", elevate_perms: true, silent: true }, { id: "652A0200FB0FD929", type: "item", auto: "no_toast", item: "farm_and_charm:chicken_nest" }, { id: "3AB2724BEFE08DAA", type: "item", auto: "no_toast", item: "valley:chicken_feed", count: 8 }, { id: "46B8159D2BDBEB41", type: "item", auto: "no_toast", item: "torchmaster:megatorch" }, { id: "701BC3CE01A9ADC9", type: "item", auto: "no_toast", item: "minecraft:egg", count: 3 }, { id: "7B28A2EA92802AFF", type: "xp_levels", auto: "no_toast", xp_levels: 1 }, { id: "47DCA31077F45949", type: "toast", title: "Two Hens and a Rooster", auto: "enabled", description: "Next: Marnie needs three eggs, and Pip is already watching the nesting box." }]
		}
		{
			id: "30B43B34367293CB"
			title: "Take Three Eggs to Marnie"
			subtitle: "Pip is watching the box."
			icon: "minecraft:egg"
			description: ["Pip: \"Is that an egg? Aunt Marnie says I get a duck if I'm useful, so I am being extremely useful.\"", "", "Marnie's three eggs are already in your bag — walk them up to the inn. For the next lot, watch the nesting box, or right-click a hen with &achicken feed&r rather than wait.", "", "Pip puts a duckling on your boot and names it Biscuit. Ducks, cows and pets have a chapter of their own: &6Animals and Fishing&r."]
			x: 4.0d
			y: -0.8d
			dependencies: ["0BFB18E2492D8F4D"]
			shape: "hexagon"
			size: 1.5d
			hide_until_deps_complete: false
			hide_details_until_startable: false
			tasks: [{ id: "3D05A5371C9099E8", type: "item", item: "minecraft:egg", count: 3L, consume_items: true }]
			rewards: [{ id: "517ECCA79929F26B", type: "command", team_reward: true, auto: "invisible", command: "/valley scene pip", elevate_perms: true, silent: true }, { id: "4D5BCA3FC4FC5199", type: "command", team_reward: true, auto: "invisible", command: "bossbar set valley:folk value 2", elevate_perms: true, silent: true }, { id: "26BE9F42D9B478DC", type: "item", auto: "no_toast", item: "duckling:duck_spawn_egg" }, { id: "6A8BC661F36AA4F5", type: "item", auto: "no_toast", item: "minecraft:white_wool", count: 16 }, { id: "403E9DBBBB72E2D4", type: "item", auto: "no_toast", item: "domesticationinnovation:pet_bed_yellow" }, { id: "11C4C31F2B3035A8", type: "loot", auto: "no_toast", table_id: 6428311738069300697L }, { id: "32C3B10CF4A8E09B", type: "command", auto: "invisible", command: "execute at @p run summon duckling:duck ~ ~ ~ {CustomName:'{\"text\":\"Biscuit\",\"color\":\"gold\"}',CustomNameVisible:1b,PersistenceRequired:1b}", elevate_perms: true, silent: true }, { id: "6048D05848A76A2C", type: "xp_levels", auto: "no_toast", xp_levels: 2 }, { id: "750E933678987564", type: "item", auto: "no_toast", item: "minecraft:slime_ball", count: 4 }, { id: "03B8EF333B97685F", type: "toast", title: "His Name Is Biscuit", auto: "enabled", description: "Next: Bram is at the broken mill west of the square, and Marnie's green planks want a furnace. Ducks and pets have their own chapter: Animals and Fishing." }]
		}
		{
			id: "167FBD502857379B"
			title: "Talk to Bram at the Broken Mill"
			subtitle: "Walk west to the mill. He will accept 'hold this'."
			icon: "valley:token_bram"
			description: ["Bram: \"I don't need help — I need somebody to hold things. Different word, same pair of hands.\"", "", "Walk west down the river from the square until you find the mill with the snapped axle (&b-329 67 -39&r). Talk to &bBram&r and bring back the Millwright's Bolt he puts in your hand.", "", "He opens his labelled crates: &a12 iron ingots&r and &a24 andesite&r. More than the eight alloys want, because the Millstone takes the rest."]
			x: 0.0d
			y: 0.0d
			dependencies: ["2CA1AF8451E957EA"]
