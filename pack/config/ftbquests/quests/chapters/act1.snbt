		}
		{
			id: "87A167074EA22047"
			title: "Put the Waystone on the Hearthstone"
			subtitle: "Name it Home."
			icon: "waystones:waystone"
			description: ["Josie: \"The hearthstone is the one thing in that house I never had to fix. Start from the part that held.\"", "", "Follow the lit path from where you woke up to the old farm — the chimney is still standing. Place the Homestead Waystone on the flat grey hearthstone beside it, type Home in the box, click the tick.", "", "The roof and the walls go back up around you, with a doorway, two window holes and a wool mat where the bed goes."]
			x: 2.0d
			y: 0.0d
			dependencies: ["E5A7BE39721C20E9"]
			hide_until_deps_complete: true
			hide_details_until_startable: true
			tasks: [{ id: "DB5CE82B1159F9DB", type: "checkmark", title: "Homestead Waystone standing on the hearthstone, named Home" }]
			rewards: [{ id: "46A042655C1B42D9", type: "item", item: "mcwdoors:oak_cottage_door" }, { id: "1F7B9F1D4602AC31", type: "item", item: "mcwwindows:oak_window", count: 4 }, { id: "606344DC4C6856A8", type: "item", item: "minecraft:red_bed" }, { id: "83A4303CAF8AD4F5", type: "item", item: "supplementaries:sconce" }, { id: "7E817E2CD0B81615", type: "toast", title: "Home", description: "Next: hang the door, put a window in each hole, the bed on the mat, the sconce by the door." }]
		}
		{
			id: "0778ACD6AAB0BFA3"
			title: "Hang the Door, Windows, Bed and Sconce"
			subtitle: "All four are in your bag."
			icon: "handcrafted:oak_table"
			description: ["Josie: \"A house is a box until somebody shuts a door in it. Go and shut the door.\"", "", "Put the Oak Cottage Door in the doorway, one Oak Window in each of the two holes, the Red Bed on the wool mat, and the Sconce on the hook by the door. Any order is right.", "", "The cottage becomes a home you can cook in, and the smoke from it is what brings Marnie up the hill."]
			x: 4.0d
			y: -0.8d
			dependencies: ["87A167074EA22047"]
			hide_until_deps_complete: true
			hide_details_until_startable: true
			tasks: [{ id: "FA1B25FC10DBBD8F", type: "checkmark", title: "Door, two windows, bed and sconce placed" }]
			rewards: [{ id: "E387ADDDA12E3432", type: "item", item: "handcrafted:oak_table" }, { id: "5066404E3C808656", type: "item", item: "handcrafted:oak_chair", count: 2 }, { id: "C5B573E9C7E956F4", type: "item", item: "farmersdelight:canvas_rug" }, { id: "A5EA0F4368FD6EDA", type: "item", item: "supplementaries:flower_box", count: 2 }, { id: "33EBDBA5AE0D0BD7", type: "item", item: "farmersdelight:cooking_pot" }, { id: "7FF5D9F0E9834438", type: "item", item: "minecraft:campfire" }, { id: "1ECCE32C959C2629", type: "item", item: "minecraft:bricks", count: 16 }, { id: "D193D6C3689688C4", type: "item", item: "farmersdelight:cabbage", count: 4 }, { id: "CFA5CED11522F9C9", type: "item", item: "minecraft:carrot", count: 4 }, { id: "A721CFE734A6A227", type: "item", item: "minecraft:potato", count: 4 }, { id: "632263481B7D960B", type: "toast", title: "Four Walls and a Door", description: "Next: place the Megatorch inside the cottage. Then the soup." }]
		}
		{
			id: "EB52C1B1FC63B43D"
			title: "Place the Megatorch Inside the Cottage"
			subtitle: "One torch, one problem solved."
			icon: "torchmaster:megatorch"
			description: ["Josie: \"The dark out here has opinions. The tall torch settles them, permanently, and you never think about it again.\"", "", "Place the Megatorch on the cottage floor, inside the walls, where you can see it from the bed.", "", "Nothing hostile spawns near home from now on — not tonight, not in December."]
			x: 6.0d
			y: -0.8d
