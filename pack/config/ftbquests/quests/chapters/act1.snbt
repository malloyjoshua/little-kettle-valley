			rewards: [{ id: "0B174613CAAED767", type: "item", item: "torchmaster:megatorch", count: 2 }, { id: "AD8A71688111914E", type: "item", item: "torchmaster:feral_flare_lantern", count: 2 }, { id: "AC30804A0189280C", type: "toast", title: "Nothing Gets In", description: "Next: two spare Megatorches are for the pens. Now dig out the cellar stairs." }]
		}
		{
			id: "2C88CB03F85D2528"
			title: "Dig Out the Cellar Stairs"
			subtitle: "About 40 marked blocks of gravel."
			icon: "minecraft:iron_door"
			description: ["Josie: \"There's a door down there I'm not going to explain yet. Dig anyway; I know you.\"", "", "There is a trapdoor under the ash in the old kitchen and it is glowing. Dig the gravel out of the stairs beneath it — about 40 marked blocks. The iron shovel is in your bag.", "", "At the bottom: a sealed iron door with no handle and four words chalked on it in her hand — Not yet. — J.K. Beside it, a Cellar Waystone and her tool chest."]
			x: 4.0d
			y: 0.8d
			dependencies: ["87A167074EA22047"]
			hide_until_deps_complete: true
			hide_details_until_startable: true
			tasks: [{ id: "ECB901AA6F35AB84", type: "checkmark", title: "Stairs cleared — you are standing below the cottage floor" }]
			rewards: [{ id: "65F422959FB6400D", type: "command", team_reward: true, command: "execute positioned {x} {y} {z} run function valley:act1/cellar_door", elevate_perms: true, silent: true }, { id: "459AEC4DD69489FE", type: "item", item: "waystones:waystone" }, { id: "A29A500C0D11FC40", type: "item", item: "minecraft:iron_axe" }, { id: "DBC6E2535DC55F65", type: "item", item: "minecraft:iron_hoe" }, { id: "155C6117C188A955", type: "item", item: "minecraft:shears" }, { id: "E98CB8F1DE3A48B2", type: "item", item: "minecraft:torch", count: 32 }, { id: "67A1959A585A2051", type: "command", command: "advancement grant @a only valley:journal/found_1", elevate_perms: true, silent: true }, { id: "6A93ABCC98E70CAF", type: "toast", title: "The Door Under the House", description: "The door stays shut until autumn. Next: hang the Copper Kettle and cook one Vegetable Soup." }]
		}
		{
			id: "9DAA2A770D01CD6E"
			title: "Cook One Vegetable Soup"
			subtitle: "Kettle on the hook, pot on the fire."
			icon: "herbalbrews:copper_tea_kettle"
			description: ["Josie: \"Kettle on the hook, soup in the pot — that is the entire ceremony. There has never been a bigger one.\"", "", "Put the campfire down outside your door, set the Cooking Pot on top of it — a Cooking Pot only cooks over a lit fire — and cook one Vegetable Soup. The cabbage, carrots and potatoes are in the basket; three planks at the bench make four bowls. The Copper Kettle hangs on the hook by the door whenever you want it.", "", "Bram's old Surveyor's Stake is in the basket with the vegetables, wrapped in a rag with your name on it — the next quest is what you do with it."]
			x: 6.0d
			y: 0.8d
			dependencies: ["0778ACD6AAB0BFA3"]
			hide_until_deps_complete: true
			hide_details_until_startable: true
