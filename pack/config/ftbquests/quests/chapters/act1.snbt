			rewards: [{ id: "0D8ED0D15BA2DC8F", type: "item", item: "farmersdelight:skillet" }, { id: "E5F154E86E653972", type: "item", item: "farmersdelight:iron_knife" }, { id: "B9F5DBDF25165CA0", type: "item", item: "farmersdelight:cabbage_seeds", count: 8 }, { id: "FEB12F113005A5AA", type: "item", item: "farmersdelight:tomato_seeds", count: 8 }, { id: "76F967D445063790", type: "item", item: "farmersdelight:rice", count: 8 }, { id: "F563B626FFCB49A3", type: "item", item: "valley:town_anchor" }, { id: "111607DCC8850393", type: "toast", title: "Put the Kettle On", description: "Next: carry the Surveyor's Stake north up the road and place it where the ground sparks green." }]
		}
		{
			id: "FB69878FA5D50650"
			title: "Place the Surveyor's Stake North of Your Gate"
			subtitle: "Walk north. The ground tells you where."
			icon: "valley:town_anchor"
			description: ["Josie: \"Bram surveyed that flat by the road twice and never drove the stake — forty years of nearly. Drive it.\"", "", "Carry Bram's Surveyor's Stake north up the road from your gate. Green sparks come up around your feet the moment you are standing on ground flat enough to hold a town — place the stake in the sparks. That spot is the Town Anchor and every building in the pack is measured from it.", "", "A stone path is laid from your door to the anchor and the first two lamp posts go up. 2 of 40."]
			x: 8.0d
			y: 0.0d
			dependencies: ["9DAA2A770D01CD6E"]
			hide_until_deps_complete: true
			hide_details_until_startable: true
			tasks: [{ id: "1C132308B2CE6D3B", type: "checkmark", title: "Surveyor's Stake placed north of the gate" }]
			rewards: [{ id: "F4D71BCE78052BF4", type: "command", team_reward: true, command: "execute positioned {x} {y} {z} run function valley:act1/square_path", elevate_perms: true, silent: true }, { id: "32FF3DC19F26D8CD", type: "command", team_reward: true, command: "bossbar set valley:lamps value 2", elevate_perms: true, silent: true }, { id: "34490DA3CA1DD6FA", type: "toast", title: "Lantern Road 2/40", description: "Next: sleep one night in your bed. Somebody is going to see the smoke." }]
		}
		{
