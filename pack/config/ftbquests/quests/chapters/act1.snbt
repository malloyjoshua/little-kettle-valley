		}
		{
			id: "7444A31B1FB2101C"
			title: "Take Bram's Hammer and Pick Off the Bench"
			subtitle: "Three by three, one swing. And a pick that reads."
			icon: "justhammers:stone_hammer"
			description: ["Bram: \"Josie said this thing made a man lazy. Then she borrowed it for eleven days and gave it back with the handle worn smooth.\"", "", "Take the &aStone Hammer&r off the peg by Bram's bench. It breaks a 3x3 face in one swing, so aim the middle of the square at the middle of the hole you want.", "", "The &aProspector's Pick&r hangs beside it: right-click bare stone underground and it names the nearest ore and how far. More in &6Ores and Mining&r.", "", "&7Two players:&r you each get a pick, and the six strikes in Q28 are counted between you — not six each."]
			x: 2.0d
			y: 0.0d
			dependencies: ["167FBD502857379B"]
			shape: "square"
			size: 1.0d
			hide_until_deps_complete: false
			hide_details_until_startable: false
			tasks: [{ id: "1D4FF67AA7FE56D2", type: "checkmark", title: "Stone Hammer off the peg and in your bag" }]
			rewards: [{ id: "7AB11217DCF84DEA", type: "item", auto: "no_toast", item: "justhammers:stone_hammer" }, { id: "0516072A906290C9", type: "item", auto: "no_toast", item: "geolosys:prospectors_pick" }, { id: "18DCA67EAFE71459", type: "command", team_reward: true, auto: "invisible", command: "/tellraw @a [{\"text\":\"Bram: \",\"color\":\"gray\"},{\"text\":\"Middle of the square, middle of the hole. And do not swing it in my mill.\",\"italic\":true}]", elevate_perms: true, silent: true }, { id: "6A672268E15E1DAA", type: "xp_levels", auto: "no_toast", xp_levels: 1 }, { id: "7AD61C81F2CABA17", type: "toast", title: "Bram's Bench, Emptied", auto: "enabled", description: "Next: read the ground west of the cottage. The iron is there, and it is not in the walls." }]
		}
		{
			id: "2F8AE9350986BEB5"
			title: "Read the Ground West of the Cottage"
			subtitle: "Every bed leaves its rubbish on the grass."
			icon: "geolosys:iron_cluster"
			description: ["Bram: \"The weight of the iron sits in beds. And every bed throws its rubbish onto the grass above it.\"", "", "Walk out the west side of the cottage, fifteen paces past the fence, and look down: rust-brown &ahematite samples&r on the grass. From the nearest one, walk seven paces north and dig down.", "", "&cNever dig the block under your own feet.&r Dig a two-wide staircase down instead, and put a torch every few steps.", "", "Fifteen blocks down the stone turns red and stays red for twenty more. Hematite breaks into &airon clusters&r; bring back 8. Your grave keeps your things — see the &6The Wild&r chapter."]
			x: 4.0d
			y: 0.8d
			dependencies: ["7444A31B1FB2101C"]
			shape: "square"
			size: 1.0d
			hide_until_deps_complete: false
			hide_details_until_startable: false
			tasks: [{ id: "64CBEA76AD0C3FB2", type: "item", title: "8 iron clusters from the bed west of the cottage", item: "geolosys:iron_cluster", count: 8L }]
			rewards: [{ id: "6B5C805638133D17", type: "item", auto: "no_toast", item: "minecraft:iron_ingot", count: 8 }, { id: "62824802AC500FFF", type: "item", auto: "no_toast", item: "minecraft:torch", count: 16 }, { id: "763109CEC46CC65D", type: "xp_levels", auto: "no_toast", xp_levels: 2 }, { id: "50BBAD4ADA7AA122", type: "toast", title: "Iron, Read Off the Grass", auto: "enabled", description: "Next: eight Andesite Alloy, two andesite and two iron nuggets at a time. Copper, gold and lead sit in beds too." }]
		}
		{
			id: "7EFC0D973670E744"
			title: "Mill 16 Flour on a Hand-Cranked Millstone"
			subtitle: "Your arm first, then the river."
			icon: "create:wheat_flour"
			description: ["Bram: \"Hand crank first. You should know exactly what the water is doing for you before it starts doing it.\"", "", "A Millstone is a cogwheel, a stone block and an &aAndesite Casing&r. Casing is not made in a grid: strip a log with your axe, put the stripped log down, and &bright-click it holding an Andesite Alloy&r.", "", "Put a &aHand Crank&r on top of the Millstone and hold right-click to turn it. Grind &a16 Wheat Flour&r for Marnie; Bram's 32 wheat covers this and Oda's order at the end of the act.", "", "The reward is the whole parts list for the Mechanical Saw, two quests from here."]
			x: 8.0d
			y: 0.0d
			dependencies: ["70AF7E0ABE69FA26"]
			shape: "square"
			size: 1.0d
			hide_until_deps_complete: false
			hide_details_until_startable: false
			tasks: [{ id: "196B8E890E4833E0", type: "item", item: "create:wheat_flour", count: 16L, consume_items: true }]
			rewards: [{ id: "7A10202CA1A5BB14", type: "item", auto: "no_toast", item: "create:encased_fan" }, { id: "3A30150DE4DEFD87", type: "item", auto: "no_toast", item: "create:andesite_alloy", count: 3 }, { id: "0AFABFEC0CB2D674", type: "item", auto: "no_toast", item: "create:andesite_casing", count: 4 }, { id: "470B56C466BBD787", type: "item", auto: "no_toast", item: "minecraft:iron_ingot", count: 8 }, { id: "64B207AF3D94BBEC", type: "loot", auto: "no_toast", table_id: 1001168104822881485L }, { id: "758EA7F3E329B9DB", type: "xp_levels", auto: "no_toast", xp_levels: 2 }, { id: "2376D2A02520F5FB", type: "toast", title: "Turn It By Hand", auto: "enabled", description: "Next: two Water Wheels — and they want Seasoned Oak Boards out of Marnie's oven." }]
		}
		{
			id: "3D62FF07E2F30634"
			title: "Dry 32 Green Oak Planks in Any Furnace"
			subtitle: "Ten seconds a plank, and they're boards."
			icon: "valley:seasoned_oak_board"
			description: ["Marnie: \"Green planks want heat and time. Josie dried every board in this valley in a furnace and was insufferable about it.\"", "", "Eight cobblestone in a ring makes a &aFurnace&r. Marnie's charcoal is in the barrel by the door.", "", "Smelt the 32 &aGreen Oak Planks&r into 32 &aSeasoned Oak Boards&r. That is five minutes of burning, so light it and go and see Bram at the mill while it works.", "", "Bram cannot build a Water Wheel until these dry. One furnace is five minutes; four furnaces is one. Kitchen kit comes with them: &6Cooking and Brewing&r."]
			x: 0.0d
			y: 1.5d
			dependencies: ["2CA1AF8451E957EA"]
			shape: "square"
			size: 1.0d
			hide_until_deps_complete: false
			hide_details_until_startable: false
			tasks: [{ id: "64DDBAAE73CBCB72", type: "item", item: "valley:seasoned_oak_board", count: 32L }]
			rewards: [{ id: "0669F7DEAF619A91", type: "command", team_reward: true, auto: "invisible", command: "tellraw @a [{\"text\":\"Bram: \",\"color\":\"gray\"},{\"text\":\"Dry boards. In April. Hm.\",\"color\":\"white\",\"italic\":true}]", elevate_perms: true, silent: true }, { id: "54B778A040082B22", type: "stage", auto: "invisible", stage: "seasoned" }, { id: "5724EBA0DD5C0927", type: "item", auto: "no_toast", item: "handcrafted:wood_crockery_combo" }, { id: "0CFCAFBFACAA10F0", type: "item", auto: "no_toast", item: "handcrafted:oak_chair" }, { id: "73EB427311358B17", type: "item", auto: "no_toast", item: "cookingforblockheads:counter" }, { id: "76B2CD7B7CB67151", type: "item", auto: "no_toast", item: "cookingforblockheads:sink" }, { id: "30A9366001661B8A", type: "item", auto: "no_toast", item: "cookingforblockheads:oven" }, { id: "534585F1CB6AB6A7", type: "item", auto: "no_toast", item: "minecraft:pumpkin", count: 2 }, { id: "4388A1F50E6E9391", type: "item", auto: "no_toast", item: "minecraft:sugar_cane", count: 4 }, { id: "1AB619808F876681", type: "xp_levels", auto: "no_toast", xp_levels: 2 }, { id: "3C9DBE499127D71A", type: "toast", title: "Dry Boards, in April", auto: "enabled", description: "Next: fit the Counter, Sink and Oven along the inn's back wall. Bram's wheels are unblocked." }]
		}
		{
