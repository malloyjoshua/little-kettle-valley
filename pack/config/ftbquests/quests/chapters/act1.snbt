	quests: [
		{
			id: "22DF54626799495A"
			title: "Till and Plant the 3x9 Patch"
			subtitle: "Wheat, carrots, potatoes."
			icon: "minecraft:wheat_seeds"
			description: ["Marnie: \"Three beds: wheat, carrots, potatoes. Anything fancier and you'll be eating it alone in July.\"", "", "Till the 3x9 patch behind the house — every tile is marked in path blocks — then plant the &a9 carrots&r, &a9 potatoes&r and &a9 wheat seeds&r from Marnie's sack. Hand in holding the seeds; the book counts them and never takes them.", "", "For what grows in which season, see the &6Farm and Seasons&r chapter."]
