			rewards: [{ id: "45D685BA2313E517", type: "item", auto: "no_toast", item: "thermal:watering_can" }, { id: "4854821CBCCED67F", type: "item", auto: "no_toast", item: "minecraft:bone_meal", count: 16 }, { id: "1AD64E7E765CF0BC", type: "item", auto: "no_toast", item: "vinery:straw_hat" }, { id: "0389C6180026B2E3", type: "item", auto: "no_toast", item: "farm_and_charm:scarecrow" }, { id: "163502DB627397E5", type: "item", auto: "no_toast", item: "minecraft:oak_fence", count: 24 }, { id: "0B57DF2F7CD391C6", type: "item", auto: "no_toast", item: "minecraft:oak_fence_gate" }, { id: "6FB58B75C3A8544D", type: "item", auto: "no_toast", item: "farm_and_charm:feeding_trough" }, { id: "61CD818FDAE83938", type: "item", auto: "no_toast", item: "valley:hen_crate", count: 3 }, { id: "0F6D5B2DF15A92B5", type: "toast", title: "Three Beds of Dirt", auto: "enabled", description: "Next: fence the pen on the marked blocks and open the three Hen Crates inside it." }]
		}
		{
			id: "0BFB18E2492D8F4D"
			title: "Fence the Pen and Open the Three Hen Crates"
			subtitle: "Two hens and a rooster."
			icon: "valley:hen_crate"
			description: ["Marnie: \"Two hens and a rooster. Don't name the rooster — you'll get attached, and he is horrible.\"", "", "Put a fence section on each of the 23 stone footings marked out behind the house, hang the gate on the single grey slab in the middle of the side facing you, then right-click all three Hen Crates inside the finished pen. Any order is right.", "", "A nesting box goes down with two eggs in it, a Megatorch goes up over the coop, and chicken feed makes a hen lay when you right-click her."]
			x: 2.0d
			y: -1.5d
			dependencies: ["22DF54626799495A"]
			hide_until_deps_complete: false
			hide_details_until_startable: false
			tasks: [{ id: "69C20F4B1D1ED3C1", type: "checkmark", title: "Three chickens standing inside the finished pen" }]
			rewards: [{ id: "751DF2986D7640D3", type: "command", team_reward: true, auto: "invisible", command: "/valley scene coop", elevate_perms: true, silent: true }, { id: "652A0200FB0FD929", type: "item", auto: "no_toast", item: "farm_and_charm:chicken_nest" }, { id: "3AB2724BEFE08DAA", type: "item", auto: "no_toast", item: "valley:chicken_feed", count: 8 }, { id: "46B8159D2BDBEB41", type: "item", auto: "no_toast", item: "torchmaster:megatorch" }, { id: "701BC3CE01A9ADC9", type: "item", auto: "no_toast", item: "minecraft:egg", count: 3 }, { id: "2945712B9F44E92E", type: "toast", title: "Two Hens and a Rooster", auto: "enabled", description: "Next: Marnie needs three eggs." }]
		}
		{
			id: "30B43B34367293CB"
			title: "Take Three Eggs to Marnie"
			subtitle: "Pip is watching the box."
			icon: "minecraft:egg"
			description: ["Pip: \"Is that an egg? Aunt Marnie says I get a duck if I'm useful, so I am being extremely useful.\"", "", "Collect 3 eggs from the nesting box behind your house — right-click a hen with chicken feed if you would rather not wait — and hand them in here. Marnie gets them either way; the book does the walking.", "", "Pip puts a duckling on your boot, names it Biscuit, and opens his courier board. Marnie tips 16 carded wool onto the counter."]
			x: 4.0d
			y: -1.5d
			dependencies: ["0BFB18E2492D8F4D"]
			hide_until_deps_complete: false
			hide_details_until_startable: false
