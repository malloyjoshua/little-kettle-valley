			title: "Sleep One Night in Your Bed"
			subtitle: "Marnie sees the chimney."
			icon: "minecraft:red_bed"
			description: ["Marnie: \"Four years I've looked at that chimney, and last night there was smoke. I've brought bread and I am not carrying it home.\"", "", "Sleep one night in the Red Bed in your cottage.", "", "Marnie moves in, the inn shell goes up at the Town Anchor, and she leaves you her seed sack, 32 Green Oak Planks and a flint and steel."]
			x: 10.0d
			y: 0.0d
			dependencies: ["FB69878FA5D50650"]
			hide_until_deps_complete: true
			hide_details_until_startable: true
