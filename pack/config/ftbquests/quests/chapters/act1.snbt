			rewards: [{ id: "3591BC634AFBC362", type: "command", team_reward: true, command: "execute positioned {x} {y} {z} run function valley:act1/marnie_arrives", elevate_perms: true, silent: true }, { id: "83006BFCB8AD685B", type: "command", team_reward: true, command: "/valley scene bram", elevate_perms: true, silent: true }, { id: "1D5629A25F03E67C", type: "command", team_reward: true, command: "/valley scene inn", elevate_perms: true, silent: true }, { id: "B6B510772891E423", type: "command", team_reward: true, command: "bossbar set valley:folk value 1", elevate_perms: true, silent: true }, { id: "423B87F3CF732616", type: "item", item: "minecraft:bread", count: 8 }, { id: "DC468CB60B925A73", type: "item", item: "waystones:waystone" }, { id: "EDFF5744CA98B391", type: "item", item: "valley:green_oak_plank", count: 32 }, { id: "BA47B8B0DCC7D201", type: "item", item: "minecraft:flint_and_steel" }, { id: "E065774855CAB93B", type: "item", item: "minecraft:wheat_seeds", count: 9 }, { id: "1191BFDA5CA26BE3", type: "item", item: "minecraft:carrot", count: 9 }, { id: "2DC0531E45C02FEC", type: "item", item: "minecraft:potato", count: 9 }, { id: "8FAAD36D0E01EFD2", type: "toast", title: "Residents 1/15", description: "Next: till the 3x9 patch behind the house. Or walk west from the stake to the mill — Bram is standing outside it now, and he needs a pair of hands." }]
		}
		{
			id: "A2DF54626799495A"
			title: "Till and Plant the 3x9 Patch"
			subtitle: "Wheat, carrots, potatoes."
			icon: "minecraft:wheat_seeds"
			description: ["Marnie: \"Three beds: wheat, carrots, potatoes. Anything fancier and you'll be eating it alone in July.\"", "", "Till the 3x9 patch behind the house — every tile is marked in path blocks — then plant the 9 carrots, 9 potatoes and 9 wheat seeds from Marnie's sack. Any order is right, but hand this in while the wheat seeds are still in your hand: the book counts them and never takes them, so those nine go in last.", "", "Marnie hands over the fence, the gate, the trough and three Hen Crates for the pen next to it."]
