			size: 1.0d
			hide_until_deps_complete: false
			hide_details_until_startable: false
			tasks: [{ id: "64CBEA76AD0C3FB2", type: "item", title: "8 iron clusters from the bed west of the cottage", item: "geolosys:iron_cluster", count: 8L }]
			rewards: [{ id: "6B5C805638133D17", type: "item", auto: "no_toast", item: "minecraft:iron_ingot", count: 8 }, { id: "62824802AC500FFF", type: "item", auto: "no_toast", item: "minecraft:torch", count: 16 }, { id: "763109CEC46CC65D", type: "xp_levels", auto: "no_toast", xp_levels: 2 }, { id: "13FB1DD854C55FE9", type: "toast", title: "Iron, Read Off the Grass", auto: "enabled", description: "Next: smelt the clusters and press eight Andesite Alloy. Copper, gold and lead sit in beds too." }]
		}
