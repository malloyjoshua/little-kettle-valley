		{
			id: "7444A31B1FB2101C"
			title: "Take Bram's Hammer and Pick Off the Bench"
			subtitle: "Three by three, one swing. And a pick that reads."
			icon: "justhammers:stone_hammer"
			description: ["Bram: \"Josie said this thing made a man lazy. Then she borrowed it for eleven days and gave it back with the handle worn smooth.\"", "", "Take the &aStone Hammer&r off the peg by Bram's bench. It breaks a 3x3 face in one swing, so aim the middle of the square at the middle of the hole you want.", "", "The &aProspector's Pick&r hangs beside it: right-click bare stone underground and it names the nearest ore and how far. More in &6Ores and Mining&r."]
			x: 2.0d
			y: 0.0d
			dependencies: ["167FBD502857379B"]
			shape: "square"
			size: 1.0d
			hide_until_deps_complete: false
			hide_details_until_startable: false
			tasks: [{ id: "1D4FF67AA7FE56D2", type: "checkmark", title: "Stone Hammer off the peg and in your bag" }]
