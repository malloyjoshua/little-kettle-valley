		}
		{
			id: "2214CAF2EDA521CB"
			title: "Walk the Frozen River, Bring the Ribbits Home"
			subtitle: "Follow Wisp's lanterns downstream and back."
			icon: "ribbits:swamp_lantern"
			description: ["Wisp: \"The reeds is all ice now, and we are four with no roof. Can we be your neighbours nearer?\"", "", "The river is solid — walk it. Follow Wisp's lit lanterns downstream to the reed village and talk to Reed, Sedge, Mudlark and Puddle. They pack up and walk back to the inn on their own; you only have to be the one who went and asked.", "", "Four Ribbits move into town for good, Wisp stops being a visitor, and Nella hands you her Ice Auger."]
			x: 4.0d
			y: -3.0d
			dependencies: ["6EB97990C3672870"]
