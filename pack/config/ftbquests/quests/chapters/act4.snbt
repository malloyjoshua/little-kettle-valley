	subtitle: ["Winter, Year One", "Keep everyone warm and fed through winter, and finish Josie's power plant so the valley never has to go dark again.", "Forty lamps. Fifteen people. One winter that nobody leaves."]
	quests: [
		{
			id: "24EE4E017AD8187D"
			title: "Sleep One Night, Then Follow Pip to the Inn"
			subtitle: "The Hearth has gone out."
			icon: "minecraft:campfire"
			description: ["Pip, at your door, out of breath: \"The Hearth's out! It's been out since supper and Aunt Marnie is just standing there looking at it!\"", "", "Sleep one night in your own bed, then walk down the hill to the inn. Everyone is already inside it. Marnie banked that fire the way she has every night for thirty years, and it went out anyway, and nobody can tell you why.", "", "Opens the winter book and hands you 64 Firewood Bundles, a winter cloak and Marnie's cocoa."]
			x: 0.0d
			y: -0.8d
			dependencies: ["447F0160D253CCD3"]
			shape: "hexagon"
			size: 1.5d
			hide_until_deps_complete: true
			hide_details_until_startable: true
			tasks: [{ id: "7978EFDBBCE88D7D", type: "checkmark", title: "A night slept, and the whole valley already inside the inn" }]
			rewards: [{ id: "155DF2E8D19F7852", type: "item", auto: "enabled", item: "valley:firewood_bundle", count: 64 }, { id: "17E094195E0F519A", type: "item", auto: "enabled", item: "valley:winter_cloak" }, { id: "1B8CFDD94C2E2856", type: "item", auto: "enabled", item: "farmersdelight:hot_cocoa", count: 8 }, { id: "6F24DCA261355BF6", type: "item", auto: "enabled", item: "minecraft:campfire", count: 4 }, { id: "5830A4C7280F19E0", type: "xp_levels", auto: "enabled", xp_levels: 3 }, { id: "2C9444441DA5B6FF", type: "toast", title: "The Winter Book Opens", auto: "enabled", description: "Next: 16 Firewood Bundles each to Marnie, Halden, Nella and Oda." }]
		}
		{
			id: "6EB97990C3672870"
			title: "Fill the Four Firewood Stacks, 16 Each"
			subtitle: "Marnie's, Halden's, Nella's and Oda's."
			icon: "valley:firewood_bundle"
			description: ["Oda, not looking up from the ledger: \"Four houses, sixteen bundles each. That is sixty-four, which is exactly what you were given.\"", "", "Put 16 Firewood Bundles into each of the four marked stacks in the inn's back room: Marnie's, Halden's, Nella's and Oda's. Any order is right.", "", "Each of them gives something back, and Wisp lights a lantern path down the frozen river."]
			x: 2.0d
			y: -1.5d
			dependencies: ["24EE4E017AD8187D"]
