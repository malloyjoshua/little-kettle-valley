			rewards: [{ id: "2FF5743BE2575FF6", type: "stage", auto: "invisible", stage: "reactor_ready" }, { id: "70CC71E8A2872F08", type: "item", auto: "no_toast", item: "biggerreactors:turbine_computer_port" }, { id: "228D8DA7462D873D", type: "item", auto: "no_toast", item: "biggerreactors:turbine_rotor_blade", count: 16 }, { id: "6084C37FE04072BC", type: "item", auto: "no_toast", item: "biggerreactors:turbine_rotor_shaft", count: 4 }, { id: "40E8BCEBA25211AF", type: "command", team_reward: true, auto: "invisible", command: "/valley scene q71", elevate_perms: true, silent: true }, { id: "1338C617412912F8", type: "xp_levels", auto: "no_toast", xp_levels: 3 }, { id: "7D02CA7B833DD0A9", type: "toast", title: "1,800 RPM, Held", auto: "enabled", description: "Next: run the coolant loop out to the six greenhouse heaters and the bathhouse tank." }]
