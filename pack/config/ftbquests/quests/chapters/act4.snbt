	quests: [
		{
			id: "24EE4E017AD8187D"
			title: "Sleep One Night, Then Follow Pip to the Inn"
			subtitle: "The Hearth has gone out. One of you sleeping is enough."
			icon: "minecraft:campfire"
			description: ["Pip, out of breath at your door: \"The Hearth's out! It's been out since supper and Aunt Marnie is just standing there looking at it!\"", "", "Sleep one night in your own bed, then walk down to the &binn&r. Everyone is already inside it.", "", "Winter opens. &aFirewood Bundles&r, a cloak and Marnie's cocoa come with it."]
			x: 0.0d
			y: -0.8d
