			size: 1.0d
			hide_until_deps_complete: true
			hide_details_until_startable: true
			tasks: [{ id: "65D25211ADC661C0", type: "item", item: "valley:lake_sand", count: 128L, consume_items: true }]
			rewards: [{ id: "7F59A38F62B20432", type: "item", auto: "enabled", item: "valley:lake_sand", count: 128 }, { id: "104120323C701DE8", type: "item", auto: "enabled", item: "minecraft:oak_boat" }, { id: "1B6DD24BC22D3C24", type: "stage", auto: "enabled", stage: "dredged" }, { id: "6DA3FC585E1CB005", type: "command", auto: "enabled", command: "/tellraw @a [{\"text\":\"Nella: \",\"color\":\"aqua\"},{\"text\":\"A hundred and twenty-eight. Take it to Bram before he asks me twice.\",\"italic\":true}]", elevate_perms: true, silent: true }, { id: "4BF3AF03E89224B8", type: "toast", title: "128 Sand on the Pier", auto: "enabled", description: "Next: 64 Washed Silica on the bench — eight Lake Sand and a bucket of water make four, and 128 sand is exactly the 64." }]
		}
		{
			id: "7E63CE8E345DA2FC"
			title: "Talk to the Prospector at the Copper Outcrop"
			subtitle: "Nobody has read his survey."
			icon: "geolosys:prospectors_pick"
			description: ["Tobin: \"You're the Kettle one — right, okay. The seam doesn't stop at the outcrop, it turns, and nobody believes me.\"", "", "Walk up to the copper outcrop on the hillside and right-click Tobin Gale. He hands you his token — turn it in here.", "", "Tobin moves into the valley with his pick and three survey maps already marked. He is right about all of it."]
			x: 0.0d
			y: 0.8d
			dependencies: ["1589859EB1A28DCE"]
			shape: "hexagon"
