			rewards: [{ id: "4FC25B18B318CD32", type: "item", auto: "enabled", item: "valley:paper_lantern", count: 12 }, { id: "4BF447B43155DE2F", type: "item", auto: "enabled", item: "vinery:winemaker_apron" }, { id: "3FC031B715F411E1", type: "item", auto: "enabled", item: "valley:scrip", count: 20 }, { id: "20D2B114F69D511A", type: "loot", auto: "enabled", table_id: 6428311738069300697L }, { id: "35EFD5660249057B", type: "command", auto: "enabled", command: "/tellraw @a [{\"text\":\"Pip: \",\"color\":\"red\"},{\"text\":\"I made TWO HUNDRED. Marnie says twenty-four. I made two hundred.\",\"italic\":true}]", elevate_perms: true, silent: true }, { id: "7DAD4073750B04C5", type: "command", auto: "enabled", command: "/tellraw @a [{\"text\":\"Marnie: \",\"color\":\"light_purple\"},{\"text\":\"Josie lit this road one February — eleven nights, soup warm the whole way up the lane — and I never asked why.\",\"italic\":true}]", elevate_perms: true, silent: true }, { id: "3A0A76B6EDDD4BF3", type: "toast", title: "Pip's Two Hundred", auto: "enabled", description: "Next: fill Oda's three notices — 24 wheat, 8 cooked fish, 8 wool." }]
		}
		{
