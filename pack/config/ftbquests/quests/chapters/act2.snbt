		{
			id: "548374093E410737"
			title: "Pull Nella's Dredge Net Eight Times"
			subtitle: "Eight pulls off Nella's boat — 128 Lake Sand."
			icon: "valley:lake_sand"
			description: ["Nella: \"Sit down, hold the rope, don't help. You never get in the water on my boat.\"", "", "Sit in Nella's boat over the shallows — or wade in from the shore — and use the Dredge Net eight times. Each pull brings up 16 Lake Sand; hand in 128. The quest checks the count and hands all 128 straight back for Bram.", "", "Lake Sand is the only source of Washed Silica, and Washed Silica is the only road to a Thermal Machine Frame. Bram's workshop waits on it."]
			x: 4.0d
			y: 0.0d
			dependencies: ["3A57AC61B313C9F8"]
