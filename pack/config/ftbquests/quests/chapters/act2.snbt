	quests: [
		{
			id: "35951AD29E0D22D4"
			title: "Trade With the Frog Folk in the Reeds"
			subtitle: "Marnie's compass is already set to it."
			icon: "ribbits:red_toadstool"
			description: ["Marnie: \"Four minutes past the reeds. Wisp already walked over and set the waystone, so you only walk it once.\"", "", "Take Marnie's Explorer's Compass — it is already set to the Ribbit village — follow it, and bring back 4 Red Toadstools. The merchant frog sells them at the stall by the boardwalk, and they also grow in the planters along it.", "", "Wisp hands over the flower starts and the bone meal that Halden's hedge garden gets planted from."]
			x: 0.0d
			y: -2.2d
			dependencies: ["1589859EB1A28DCE"]
