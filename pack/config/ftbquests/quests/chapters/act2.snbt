			rewards: [{ id: "F3B8B0D985E0514C", type: "command", command: "/bossbar set valley:lamps value 10", elevate_perms: true, silent: true }, { id: "0D52683821CC832F", type: "item", item: "torchmaster:megatorch", count: 2 }, { id: "574210CC69B5386C", type: "item", item: "thermal:energy_duct", count: 32 }, { id: "95123C912121D9C7", type: "command", command: "/tellraw @a [{\"text\":\"Oda: \",\"color\":\"gold\"},{\"text\":\"Ten. Write it in the ledger. I want it in ink.\",\"italic\":true}]", elevate_perms: true, silent: true }, { id: "E975EA0D7E44E730", type: "toast", title: "Lamps 10 / 40", description: "Next: Wisp's stilt house over the shallows. Every spot on the decking is marked." }]
