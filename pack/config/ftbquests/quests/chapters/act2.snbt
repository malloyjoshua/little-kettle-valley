		}
		{
			id: "3A57AC61B313C9F8"
			title: "Catch 10 Fish and Cook One in the Skillet"
			subtitle: "Any ten fish, then one cooked cod."
			icon: "aquaculture:fish_fillet_cooked"
			description: ["Nella: \"Ten, any ten. The lake isn't fussy and neither am I.\"", "", "Cast Nella's Iron Rod from the shore until you have caught ten fish — any ten, she isn't fussy — then cook one cod on a Farmer's Delight Skillet and hand the cooked cod in.", "", "Nothing counts the ten for you: tick the box when you have had ten on the hook. Nella would tell you to round down and she'd be lying too.", "", "The Dredge Net comes out of this, and the dredge is where the sand for the workshop's first machine comes from."]
			x: 2.0d
			y: -2.2d
			dependencies: ["3A4D2C8BF6E503C2"]
			shape: "circle"
			size: 1.0d
			hide_until_deps_complete: true
			hide_details_until_startable: true
			tasks: [{ id: "5863EB15DEA223B5", type: "checkmark", title: "Ten fish caught (tick this yourself — honour system)" }, { id: "664E50F54F198081", type: "item", item: "minecraft:cooked_cod", count: 1L }]
			rewards: [{ id: "498874E73210826F", type: "item", auto: "enabled", item: "aquaculture:worm", count: 16 }, { id: "5D1D821D0FEF189F", type: "item", auto: "enabled", item: "sophisticatedbackpacks:copper_backpack" }, { id: "52C5011CB170B240", type: "item", auto: "enabled", item: "farmersdelight:cutting_board" }, { id: "01811FB22626B427", type: "item", auto: "enabled", item: "farmersdelight:iron_knife" }, { id: "2C027C25C4D2B365", type: "item", auto: "enabled", item: "artifacts:anglers_hat" }, { id: "0A08DF1B132BFF03", type: "item", auto: "enabled", item: "create:copper_diving_helmet" }, { id: "7E0E2E3BFAEBABA0", type: "item", auto: "enabled", item: "valley:dredge_net" }, { id: "64AEC16E25701977", type: "toast", title: "Nella's hat fits you", auto: "enabled", description: "Next: pull the dredge net eight times from her boat." }]
		}
		{
			id: "2F56F12A0B4EDB5F"
			title: "Bring Halden 24 Flowers for the Hedge Garden"
			subtitle: "Poppies, dandelions, cornflowers — eight of each."
			icon: "minecraft:poppy"
			description: ["Halden: \"Nothing in a hedge garden is urgent. That is more or less the entire argument for having one.\"", "", "Plant Wisp's poppy, dandelion and cornflower in the three flower boxes on your window ledge, then bone-meal the grass on the flat by the Town Anchor — that ground is plains, and plains grows all three — until you have 8 of each. Bring all 24 to Halden on the south slope.", "", "Halden opens the hedge garden to the town, the spring above it starts running, and the trellis and grape starts for the slope come with him."]
			x: 2.0d
			y: -0.8d
			dependencies: ["1589859EB1A28DCE", "35951AD29E0D22D4"]
			shape: "hexagon"
			size: 1.5d
			hide_until_deps_complete: true
			hide_details_until_startable: true
			tasks: [{ id: "69363D6F122AAE85", type: "item", item: "minecraft:poppy", count: 8L, consume_items: true }, { id: "3DA52AE5817F9372", type: "item", item: "minecraft:dandelion", count: 8L, consume_items: true }, { id: "658A3CDDCD086371", type: "item", item: "minecraft:cornflower", count: 8L, consume_items: true }]
			rewards: [{ id: "7510F68DEC5BB351", type: "item", auto: "enabled", item: "herbalbrews:copper_tea_kettle" }, { id: "090B5925FE196589", type: "item", auto: "enabled", item: "herbalbrews:flask", count: 4 }, { id: "7CB8B05698DB5B9D", type: "item", auto: "enabled", item: "herbalbrews:green_tea_leaf", count: 16 }, { id: "14A043BBE0686DD7", type: "item", auto: "enabled", item: "vinery:oak_lattice", count: 8 }, { id: "3931613F8F9786BB", type: "item", auto: "enabled", item: "vinery:red_grape_seeds", count: 4 }, { id: "5ACC29758EA40925", type: "item", auto: "enabled", item: "thermal:watering_can" }, { id: "6145515C5F0504D0", type: "item", auto: "enabled", item: "valley:spring_water", count: 3 }, { id: "5218BDE16E361C46", type: "command", auto: "enabled", command: "/tellraw @a [{\"text\":\"Halden: \",\"color\":\"green\"},{\"text\":\"Josie planted the first hedge here. I only ever kept it trimmed. That can change now.\",\"italic\":true}]", elevate_perms: true, silent: true }, { id: "25BAFAC62D0590A4", type: "command", auto: "enabled", command: "/tellraw @a [{\"text\":\"Halden: \",\"color\":\"green\"},{\"text\":\"You found the door under her kitchen, then. I know what it says and who wrote it. Not on a summer afternoon.\",\"italic\":true}]", elevate_perms: true, silent: true }, { id: "36FB1A0EA7763B20", type: "toast", title: "The Hedge Garden Opens", auto: "enabled", description: "Next: put the trellis up on the south terrace and plant the 4 grape starts." }]
		}
		{
