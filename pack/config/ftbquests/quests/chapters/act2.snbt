			size: 1.5d
			hide_until_deps_complete: true
			hide_details_until_startable: true
			tasks: [{ id: "69363D6F122AAE85", type: "item", item: "minecraft:poppy", count: 8L, consume_items: true }, { id: "BDA52AE5817F9372", type: "item", item: "minecraft:dandelion", count: 8L, consume_items: true }, { id: "658A3CDDCD086371", type: "item", item: "minecraft:cornflower", count: 8L, consume_items: true }]
			rewards: [{ id: "7510F68DEC5BB351", type: "item", item: "herbalbrews:copper_tea_kettle" }, { id: "890B5925FE196589", type: "item", item: "herbalbrews:flask", count: 4 }, { id: "FCB8B05698DB5B9D", type: "item", item: "herbalbrews:green_tea_leaf", count: 16 }, { id: "94A043BBE0686DD7", type: "item", item: "vinery:oak_lattice", count: 8 }, { id: "3931613F8F9786BB", type: "item", item: "vinery:red_grape_seeds", count: 4 }, { id: "5ACC29758EA40925", type: "item", item: "thermal:watering_can" }, { id: "6145515C5F0504D0", type: "item", item: "valley:spring_water", count: 3 }, { id: "D218BDE16E361C46", type: "command", command: "/tellraw @a [{\"text\":\"Halden: \",\"color\":\"green\"},{\"text\":\"Josie planted the first hedge here. I only ever kept it trimmed. That can change now.\",\"italic\":true}]", elevate_perms: true, silent: true }, { id: "384E836139413FC7", type: "command", command: "/bossbar set valley:folk value 7", elevate_perms: true, silent: true }, { id: "D02A1A11D002467C", type: "toast", title: "Halden opens the hedge garden", description: "Next: put the trellis up on the south terrace and plant the 4 grape starts." }]
		}
