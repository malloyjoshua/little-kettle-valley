			rewards: [{ id: "C7E446091D131BA6", type: "item", item: "waystones:waystone" }, { id: "5882054579F667FF", type: "item", item: "storagedrawers:controller" }, { id: "D581D1B3D00E0FF3", type: "item", item: "storagedrawers:copper_storage_upgrade", count: 12 }, { id: "BF9A25A282BF4DCE", type: "item", item: "storagedrawers:drawer_key" }, { id: "4204AFB10F706FCD", type: "stage", stage: "granary" }, { id: "0CD5636AFA9019D9", type: "command", command: "/tellraw @a [{\"text\":\"Oda: \",\"color\":\"gold\"},{\"text\":\"The key's brass. My initials are scratched off it and yours are scratched on. Don't lose it.\",\"italic\":true}]", elevate_perms: true, silent: true }, { id: "0AFB4D111BECCDE7", type: "command", command: "advancement grant @a only valley:journal/found_4", elevate_perms: true, silent: true }, { id: "00A2636888D2CE0A", type: "toast", title: "Granary stocked", description: "Next: the four marked beds behind the inn — pumpkin, beetroot, oats and barley, four of each." }]
		}
		{
			id: "5C9E4AA1B6ADCEA6"
			title: "Sow the Four Autumn Crops"
			subtitle: "Marked beds behind the inn."
			icon: "minecraft:pumpkin_seeds"
			description: ["Marnie: \"Pumpkin, beetroot, oats and barley. Everything else is finished for the year, love, and arguing with it won't feed anybody.\"", "", "Plant 4 Pumpkin Seeds, 4 Beetroot Seeds, 4 Oat Seeds and 4 Barley Seeds in the four marked beds behind the inn, and hand in holding four of each — the book counts them and never takes them, so they go in the ground after. Oda's Seed Box is four Scrip for the pumpkin and beetroot; the Oat Seeds are Bakery's and the Barley Seeds are Thermal's, spelled exactly like that. Any order is right.", "", "It pays out the larder crate — eggs, sugar, milk, meat, apples and twelve empty jars — which is everything the preserving work needs."]
			x: 2.0d
			y: 0.0d
			dependencies: ["B79DF28AF21498E4"]
			hide_until_deps_complete: true
			hide_details_until_startable: true
