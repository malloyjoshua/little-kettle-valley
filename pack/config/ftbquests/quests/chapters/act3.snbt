			rewards: [{ id: "C5CE1850173898AD", type: "command", command: "/valley finale act3", elevate_perms: true, silent: true }, { id: "EC3889522CCEAFB1", type: "stage", stage: "act4" }, { id: "295DD626823FAF55", type: "toast", title: "The Harvest Supper", description: "Next: sleep one night, then follow Pip down to the inn. Winter starts in the morning." }]
