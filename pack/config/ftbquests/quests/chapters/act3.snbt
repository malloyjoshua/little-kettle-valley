			rewards: [{ id: "05A46210A46B085B", type: "item", item: "thermal:energy_cell" }, { id: "8192B8759C02BC8F", type: "item", item: "cookingforblockheads:fridge" }, { id: "B45E8504BD99FBB9", type: "item", item: "cookingforblockheads:sink" }, { id: "5BBBE57E1F439EB7", type: "item", item: "cookingforblockheads:milk_jar" }, { id: "FC264B7924FFDA19", type: "item", item: "thermal:energy_duct", count: 64 }, { id: "ABD493D682869541", type: "command", command: "/tellraw @a [{\"text\":\"Bram: \",\"color\":\"gray\"},{\"text\":\"Fridge works. Told her I was working on it.\",\"italic\":true}]", elevate_perms: true, silent: true }, { id: "53724A5E2497EDB7", type: "toast", title: "The inn has power", description: "Next: a Create train station at the mill and 64 track laid to the square." }]
