		}
		{
			id: "CB7C03A613A457FE"
			title: "Read the Cellar Wall"
			subtitle: "Down the stairs under the farmhouse."
			icon: "minecraft:iron_door"
			description: ["Josie, in chalk, in her own hand: \"A machine that one person can run is not infrastructure — it's a hostage. So I shut it off and I waited for two of you.\"", "", "Go back down the stairs under the farmhouse. It finished turning some time in the night and it is standing open — stand in front of the cellar wall until you have read the whole thing.", "", "The cellar waystone is yours for the walk back, her chalk copies itself into the journal, and her original reactor blueprint is rolled in the tube by the stairs."]
			x: 10.0d
			y: 1.5d
			dependencies: ["C63503CEDF72AFBE"]
			shape: "diamond"
			size: 1.5d
			hide_until_deps_complete: true
			hide_details_until_startable: true
			tasks: [{ id: "BEF6120442290A6E", type: "checkmark", title: "You are standing in the cellar, in front of the wall." }]
			rewards: [{ id: "73BA21E60E087C8A", type: "item", item: "waystones:waystone" }, { id: "6FD7A83C87BE2A1D", type: "item", item: "create:orange_toolbox" }, { id: "058AA334012F4326", type: "item", item: "create:crafting_blueprint" }, { id: "42363C52BFC025A4", type: "loot", table_id: 10797532679477389079L }, { id: "B604C10435D45D91", type: "command", command: "/tellraw @a [{\"text\":\"Josie, on the wall: \",\"color\":\"gold\"},{\"text\":\"If there's more than one set of footprints on my cellar stairs, then I was right to wait. Go and turn it on.\",\"italic\":true}]", elevate_perms: true, silent: true }, { id: "005A6CC308CB8681", type: "command", command: "advancement grant @a only valley:journal/cellar_wall", elevate_perms: true, silent: true }, { id: "808766ABB417868B", type: "toast", title: "The Works was a power plant", description: "Next: the long table in the square — twelve place settings and the centrepiece. That's the Harvest Supper. And Tobin is stood at the collapsed adit with a shovel and a theory: the Works opens from there." }]
		}
		{
			id: "C47F0160D253CCD3"
			title: "Set the Long Table for Twelve"
			subtitle: "Act III finale — twelve settings and one centrepiece."
			icon: "handcrafted:white_crockery_combo"
			description: ["Marnie: \"Twelve places: nobody stands, nobody eats in the kitchen, and nobody eats alone. That's the rule tonight.\"", "", "Place the Long Table in the square, put one White Crockery setting on each of the twelve marked spots, and set the Candle Holder in the middle. Any order is right.", "", "Forty lamps. Fifteen people. One winter that nobody leaves.", "", "Sit down. The granary's full, the lamps are lit down the road, and there are three empty chairs at this table because Marnie set it for the year we are going to have."]
			x: 18.0d
			y: 0.0d
			dependencies: ["177A495F36B16021", "B53BBFB416B61074", "2A58745479C32D0A", "CB7C03A613A457FE"]
