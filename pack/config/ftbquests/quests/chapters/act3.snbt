			rewards: [{ id: "4E5A706B1E91E20F", type: "item", item: "valley:scrip", count: 30 }, { id: "3F723B616E5EEEE7", type: "item", item: "patchouli:guide_book" }, { id: "2CBBFECBE5EC9306", type: "item", item: "minecraft:filled_map" }, { id: "87EA2B9EB0A7AE7B", type: "command", command: "/tellraw @a [{\"text\":\"Oda: \",\"color\":\"gold\"},{\"text\":\"Twelve alcoves in the granary shell. Twelve drawers. Nobody is going hungry on my arithmetic.\",\"italic\":true}]", elevate_perms: true, silent: true }, { id: "56FCAD039FF18AD8", type: "toast", title: "The ledger is open", description: "Next: twelve drawers into the granary's twelve alcoves, and the autumn seed pack into the marked beds." }]
		}
		{
			id: "F6C4B9946F943E38"
			title: "Fill the Granary's Twelve Alcoves"
			subtitle: "One drawer per alcove, at the Lantern Float."
			icon: "storagedrawers:oak_full_drawers_1"
			description: ["Oda: \"The shell went up at the Lantern Float: twelve alcoves, twelve drawers. Do not improvise on me.\"", "", "Craft 12 Oak Full Drawers — the single-compartment kind, oak planks and sticks at any bench — and put one into each of the twelve marked alcoves in the granary at the Lantern Float. Any order is right.", "", "The drawers arrive already holding the town's current stock, and the Granary Waystone goes up outside the door."]
			x: 2.0d
			y: -1.5d
			dependencies: ["B79DF28AF21498E4"]
