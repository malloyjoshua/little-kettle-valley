		}
		{
			id: "8A2EA8E5F9EA51CB"
			title: "Grow Thirty-Two Certus in Spring Water"
			subtitle: "Josie's jar starts the first batch."
			icon: "ae2:certus_quartz_crystal"
			description: ["Halden: \"She kept that jar on my shelf for four years and told me I'd know when. I know when.\"", "", "Plant Certus Quartz Seeds in Halden's Spring Water and grow 32 Certus Quartz Crystals. The 16 from Josie's jar seed the first batch immediately, and the four Growth Accelerators in this payout turn every batch after it into overnight work.", "", "Thirty-two certus is exactly the drive, two cells and terminal the next quest asks for. Halden's compass points at a sky-stone meteorite: dig it out and take the four presses from the chest inside — silicon, logic, calculation, engineering. Nothing on this lane crafts without them, and the nether quartz for fluix is in the same chest, so the Nether stays shut."]
			x: 8.0d
			y: 0.0d
			dependencies: ["92F011564E219F52", "92CF0601171AFE5B"]
			hide_until_deps_complete: true
			hide_details_until_startable: true
