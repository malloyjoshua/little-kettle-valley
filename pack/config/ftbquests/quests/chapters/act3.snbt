			rewards: [{ id: "4272092AC864785B", type: "item", auto: "no_toast", item: "valley:spring_water", count: 6 }, { id: "70D786EA782D6C0C", type: "item", auto: "no_toast", item: "ae2:certus_quartz_crystal", count: 16 }, { id: "2ADA794E479DA8BF", type: "item", auto: "no_toast", item: "herbalbrews:tea_kettle" }, { id: "6316D0CEC7217DE6", type: "item", auto: "no_toast", item: "herbalbrews:copper_tea_kettle" }, { id: "7FE1FAB13191BC99", type: "stage", auto: "invisible", stage: "springwater" }, { id: "7B7D7C7CB4AEF001", type: "command", team_reward: true, auto: "invisible", command: "/tellraw @p [{\"text\":\"Halden: \",\"color\":\"green\"},{\"text\":\"She left the jar with me. I never asked what for. I think I knew.\",\"italic\":true}]", elevate_perms: true, silent: true }, { id: "7461F298B5823A53", type: "command", team_reward: true, auto: "invisible", command: "/tellraw @p [{\"text\":\"Halden: \",\"color\":\"green\"},{\"text\":\"She walked that slope in February in her shirtsleeves and called it good circulation, and snow never sat on it.\",\"italic\":true}]", elevate_perms: true, silent: true }, { id: "2D9AF5E08D94BD29", type: "xp_levels", auto: "no_toast", xp_levels: 2 }, { id: "5CC82C2FC04A1AED", type: "toast", title: "Spring Water bottled", auto: "enabled", description: "Next: plant her sixteen crystals in that water and grow thirty-two." }]
