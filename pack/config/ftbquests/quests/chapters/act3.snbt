			rewards: [{ id: "89FB5C19F1219FC0", type: "item", item: "farm_and_charm:scarecrow" }, { id: "7F8E34C69682510B", type: "item", item: "patchouli:guide_book" }, { id: "CE913FA34D1132E4", type: "item", item: "minecraft:egg", count: 32 }, { id: "A78B4BBD42CF1AC0", type: "item", item: "minecraft:sugar", count: 32 }, { id: "9CC988A72299E10F", type: "item", item: "farmersdelight:milk_bottle", count: 12 }, { id: "D9F71BDEF1CCAFDA", type: "item", item: "minecraft:beef", count: 32 }, { id: "7F1EDC9A1FF51924", type: "item", item: "minecraft:apple", count: 16 }, { id: "C5F7DAE2CB62083D", type: "item", item: "bakery:jar", count: 12 }, { id: "635680FBF8088D56", type: "loot", table_id: 6428311738069300697L }, { id: "26A91E1039ADF1B1", type: "toast", title: "Autumn sown", description: "Next: Halden is waiting at the hedge garden gate to walk you up to the spring." }]
