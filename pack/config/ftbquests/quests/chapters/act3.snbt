			rewards: [{ id: "4065BC7E8A1A966E", type: "item", item: "ae2:inscriber" }, { id: "08B0C065673832D5", type: "item", item: "ae2:meteorite_compass" }, { id: "31A28BB646CBAE3A", type: "item", item: "ae2:growth_accelerator", count: 4 }, { id: "0AB2A05430039502", type: "item", item: "ae2:charger" }, { id: "6E08D7FFB0F69509", type: "command", command: "/tellraw @p [{\"text\":\"Halden: \",\"color\":\"green\"},{\"text\":\"The compass is already pointing. She set it. I only carried it.\",\"italic\":true}]", elevate_perms: true, silent: true }, { id: "A0A70E5B9DA6859D", type: "toast", title: "Certus growing", description: "Next: an ME Drive, 2 storage cells and a terminal in the mill workshop." }]
