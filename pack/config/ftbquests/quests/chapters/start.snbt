		{
			id: "7B69878FA5D50650"
			title: "Place the Surveyor's Stake North of Your Gate"
			subtitle: "Walk north. The ground tells you where."
			icon: "valley:town_anchor"
			description: ["Josie: \"Bram surveyed that flat by the road twice and never drove the stake — forty years of nearly. Drive it.\"", "", "Carry Bram's Surveyor's Stake north up the road. Green sparks come up round your feet the moment the ground is flat enough to hold a town — drive the stake in the sparks. Every building in the valley is measured from that spot.", "", "Walk until the cottage chimney is small behind you. Stake it in your own dooryard and the square and the mill land on top of the farm.", "", "A stone path is laid from your door to the anchor and the first two lamp posts go up. 2 of 40."]
			x: 8.0d
			y: 0.0d
			dependencies: ["1DAA2A770D01CD6E"]
			min_width: 300
			hide_until_deps_complete: false
			hide_details_until_startable: false
			tasks: [{ id: "1C132308B2CE6D3B", type: "checkmark", title: "Surveyor's Stake placed north of the gate" }]
