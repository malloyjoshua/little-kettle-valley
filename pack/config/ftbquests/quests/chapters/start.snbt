		{
			id: "07A167074EA22047"
			title: "Put the Waystone on the Hearthstone"
			subtitle: "Name it Home."
			icon: "waystones:waystone"
			description: ["Josie: \"The hearthstone is the one thing in that house I never had to fix. Start from the part that held.\"", "", "Follow the road to the old farm (&b-319 74 32&r): signposted gate, standing chimney, no door on the house. Put the &aHomestead Waystone&r on the flat grey hearthstone, type Home, click the tick.", "", "Nothing is rebuilt and nothing is moved. It is your house from that moment. Scrolls and maps: &6Getting Around&r."]
			x: 2.0d
			y: 0.0d
			dependencies: ["65A7BE39721C20E9"]
			shape: "hexagon"
			size: 1.5d
			hide_until_deps_complete: false
			hide_details_until_startable: false
			tasks: [{ id: "5B5CE82B1159F9DB", type: "checkmark", title: "Homestead Waystone standing on the hearthstone, named Home" }]
