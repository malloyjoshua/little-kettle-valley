		{
			id: "2C88CB03F85D2528"
			title: "Dig Out the Cellar Stairs"
			subtitle: "About 40 marked blocks of gravel."
			icon: "minecraft:iron_door"
			description: ["Josie: \"There's a door down there I'm not going to explain yet. Dig anyway; I know you.\"", "", "There is a trapdoor under the ash in the old kitchen and it is glowing. Dig the gravel out of the stairs beneath it — about 40 marked blocks. The iron shovel is in your bag.", "", "At the bottom: a sealed iron door, no handle, four words in her chalk — Not yet. — J.K. Beside it, a Cellar Waystone and her tool chest."]
			x: 4.0d
			y: 0.8d
			dependencies: ["07A167074EA22047"]
			hide_until_deps_complete: false
			hide_details_until_startable: false
			tasks: [{ id: "6CB901AA6F35AB84", type: "checkmark", title: "Stairs cleared — you are standing below the cottage floor" }]
			rewards: [{ id: "4AA268A487861C55", type: "command", team_reward: true, auto: "invisible", command: "/valley scene cellar", elevate_perms: true, silent: true }, { id: "459AEC4DD69489FE", type: "item", auto: "no_toast", item: "waystones:waystone" }, { id: "229A500C0D11FC40", type: "item", auto: "no_toast", item: "minecraft:iron_axe" }, { id: "5BC6E2535DC55F65", type: "item", auto: "no_toast", item: "minecraft:iron_hoe" }, { id: "155C6117C188A955", type: "item", auto: "no_toast", item: "minecraft:shears" }, { id: "698CB8F1DE3A48B2", type: "item", auto: "no_toast", item: "minecraft:torch", count: 32 }, { id: "67A1959A585A2051", type: "command", auto: "invisible", command: "advancement grant @a only valley:journal/found_1", elevate_perms: true, silent: true }, { id: "7D07257A56C6438A", type: "command", auto: "invisible", command: "title @p times 10 70 20", elevate_perms: true, silent: true }, { id: "49B28F0A446DF0B2", type: "command", auto: "invisible", command: "title @p subtitle {\"text\": \"No handle. Her chalk still on it.\", \"color\": \"gray\", \"italic\": true}", elevate_perms: true, silent: true }, { id: "6163C5F12E35162D", type: "command", auto: "invisible", command: "title @p title {\"text\": \"Josie's Cellar\", \"color\": \"gold\"}", elevate_perms: true, silent: true }, { id: "4D8DAA8A512C53DA", type: "command", auto: "invisible", command: "execute at @p run playsound minecraft:block.bell.resonate master @p ~ ~ ~ 1 1", elevate_perms: true, silent: true }, { id: "74C3750CF15CB19B", type: "toast", title: "The Door Under the House", auto: "enabled", description: "Next: hang the Copper Kettle and cook one Vegetable Soup. The door has no handle and no keyhole, and the chalk on it is not old." }]
		}
		{
			id: "1DAA2A770D01CD6E"
			title: "Cook One Vegetable Soup"
			subtitle: "Kettle on the hook, pot on the fire."
			icon: "herbalbrews:copper_tea_kettle"
			description: ["Josie: \"Kettle on the hook, soup in the pot — that is the entire ceremony. There has never been a bigger one.\"", "", "Put the campfire outside your door, hang the Copper Kettle on the hook above it, and cook one Vegetable Soup in the Cooking Pot — a pot only cooks over lit fire. Cabbage, carrots and potatoes are in the basket; three planks make four bowls.", "", "Bram's old Surveyor's Stake is in the vegetable basket, wrapped in a rag with a chalk K on it — the next quest is what you do with it."]
			x: 6.0d
			y: 0.8d
