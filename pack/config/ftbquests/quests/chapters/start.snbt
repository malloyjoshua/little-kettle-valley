	quests: [
		{
			id: "65A7BE39721C20E9"
			title: "Read Josie's Letter"
			subtitle: "The last page is a map."
			icon: "valley:letter"
			description: ["Josie: \"If you're reading this I'm dead and the valley is cold. Only one of those is your problem.\"", "", "Right-click &aJosie's Letter&r in your bag and read all four pages. The last one maps the old Kettle farm.", "", "Forty lamp posts stand along that road and not one is lit. New here? Read the &6Read Me First&r chapter."]
