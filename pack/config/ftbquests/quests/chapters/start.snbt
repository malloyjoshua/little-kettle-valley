		{
			id: "65A7BE39721C20E9"
			title: "Read Josie's Letter"
			subtitle: "The last page is a map."
			icon: "valley:letter"
			description: ["Josie: \"If you're reading this I'm dead and the valley is cold. Only one of those is your problem.\"", "", "Take Josie's Letter out of your bag and right-click it. Read all four pages — the last one tells you where the old Kettle farm is.", "", "Forty lamps. Fifteen people. One winter that nobody leaves."]
			x: 0.0d
			y: 0.0d
			shape: "hexagon"
			size: 1.5d
			hide_details_until_startable: false
			tasks: [{ id: "6DB24C793602F5C8", type: "checkmark", title: "Josie's Letter read — all four pages" }]
			rewards: [{ id: "2CE6C10F10901267", type: "command", auto: "invisible", command: "give @p patchouli:guide_book{'patchouli:book':'patchouli:valley_journal'}", elevate_perms: true, silent: true }, { id: "2E02494110ABA558", type: "command", auto: "invisible", command: "advancement grant @p only valley:journal/entry_1", elevate_perms: true, silent: true }, { id: "2F4454DEC6D9AC3E", type: "item", auto: "no_toast", item: "herbalbrews:copper_tea_kettle" }, { id: "247FEDC305D9174F", type: "item", auto: "no_toast", item: "waystones:waystone" }, { id: "1179D57ACB5764B2", type: "item", auto: "no_toast", item: "minecraft:iron_shovel" }, { id: "6B7D5A8547F763D1", type: "item", auto: "no_toast", item: "minecraft:iron_pickaxe" }, { id: "2D3CBD17C7A4B6CB", type: "item", auto: "no_toast", item: "minecraft:cooked_beef", count: 16 }, { id: "0C7370F659BD5285", type: "item", auto: "no_toast", item: "minecraft:torch", count: 16 }, { id: "60EC286BB1A9A20D", type: "item", auto: "no_toast", item: "torchmaster:megatorch" }, { id: "012DF3FB05FF88E4", type: "toast", title: "Found on the Mantle", auto: "enabled", description: "Next: follow the lit path from where you woke up. It ends at the old Kettle farm. Put the waystone on the flat grey hearthstone by the chimney." }]
		}
		{
			id: "07A167074EA22047"
			title: "Put the Waystone on the Hearthstone"
			subtitle: "Name it Home."
			icon: "waystones:waystone"
			description: ["Josie: \"The hearthstone is the one thing in that house I never had to fix. Start from the part that held.\"", "", "Follow the lit path from where you woke up to the old farm — the chimney is still standing. Place the Homestead Waystone on the flat grey hearthstone beside it, type Home in the box, click the tick.", "", "The roof and the walls go back up around you, with a doorway, two window holes and a wool mat where the bed goes."]
			x: 2.0d
			y: 0.0d
			dependencies: ["65A7BE39721C20E9"]
			hide_until_deps_complete: false
			hide_details_until_startable: false
			tasks: [{ id: "5B5CE82B1159F9DB", type: "checkmark", title: "Homestead Waystone standing on the hearthstone, named Home" }]
