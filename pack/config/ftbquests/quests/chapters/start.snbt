		{
			id: "65A7BE39721C20E9"
			title: "Read Josie's Letter"
			subtitle: "The last page is a map."
			icon: "valley:letter"
			description: ["Josie: “If you're reading this I'm dead and the valley is cold. Only one of those is your problem.”", "", "Take Josie's Letter out of your bag and right-click it. Read all four pages — the last one tells you where the old Kettle farm is.", "", "Forty lamp posts stand along the road out of here and not one of them is lit. That is the whole job."]
			x: 0.0d
			y: 0.0d
			shape: "hexagon"
			size: 1.5d
			hide_details_until_startable: false
			tasks: [{ id: "6DB24C793602F5C8", type: "checkmark", title: "Josie's Letter read — all four pages" }]
			rewards: [{ id: "2CE6C10F10901267", type: "command", auto: "invisible", command: "give @p patchouli:guide_book{'patchouli:book':'patchouli:valley_journal'}", elevate_perms: true, silent: true }, { id: "2E02494110ABA558", type: "command", auto: "invisible", command: "advancement grant @p only valley:journal/entry_1", elevate_perms: true, silent: true }, { id: "2F4454DEC6D9AC3E", type: "item", auto: "no_toast", item: "herbalbrews:copper_tea_kettle" }, { id: "247FEDC305D9174F", type: "item", auto: "no_toast", item: "waystones:waystone" }, { id: "1179D57ACB5764B2", type: "item", auto: "no_toast", item: "minecraft:iron_shovel" }, { id: "6B7D5A8547F763D1", type: "item", auto: "no_toast", item: "minecraft:iron_pickaxe" }, { id: "2D3CBD17C7A4B6CB", type: "item", auto: "no_toast", item: "minecraft:cooked_beef", count: 16 }, { id: "0C7370F659BD5285", type: "item", auto: "no_toast", item: "minecraft:torch", count: 16 }, { id: "60EC286BB1A9A20D", type: "item", auto: "no_toast", item: "torchmaster:megatorch" }, { id: "1CD8EB4FA62FC459", type: "toast", title: "Found on the Mantle", auto: "enabled", description: "Next: follow the road from where you woke up. It ends at the Kettle farm gate. Put the waystone on the flat grey hearthstone in the middle of the kitchen floor." }]
		}
		{
			id: "07A167074EA22047"
			title: "Put the Waystone on the Hearthstone"
			subtitle: "Name it Home."
			icon: "waystones:waystone"
			description: ["Josie: “The hearthstone is the one thing in that house I never had to fix. Start from the part that held.”", "", "Follow the road from where you woke up to the old farm — the gate is signposted and the chimney is standing. The house is standing too: cold, empty, no door on it. Place the Homestead Waystone on the flat grey hearthstone in the middle of the kitchen floor, type Home in the box, click the tick.", "", "Nothing is rebuilt and nothing is moved. It is your house from that moment, exactly as she left it."]
			x: 2.0d
			y: 0.0d
			dependencies: ["65A7BE39721C20E9"]
			hide_until_deps_complete: false
			hide_details_until_startable: false
			tasks: [{ id: "5B5CE82B1159F9DB", type: "checkmark", title: "Homestead Waystone standing on the hearthstone, named Home" }]
			rewards: [{ id: "46A042655C1B42D9", type: "item", auto: "no_toast", item: "mcwdoors:oak_cottage_door" }, { id: "1F7B9F1D4602AC31", type: "item", auto: "no_toast", item: "mcwwindows:oak_window", count: 4 }, { id: "606344DC4C6856A8", type: "item", auto: "no_toast", item: "minecraft:red_bed" }, { id: "03A4303CAF8AD4F5", type: "item", auto: "no_toast", item: "supplementaries:sconce" }, { id: "3909924DC9EECA49", type: "command", auto: "invisible", command: "title @p times 10 70 20", elevate_perms: true, silent: true }, { id: "37EB2B67F0DD3D0B", type: "command", auto: "invisible", command: "title @p subtitle {\"text\": \"Start from the part that held.\", \"color\": \"gray\", \"italic\": true}", elevate_perms: true, silent: true }, { id: "52413EC55D5746E2", type: "command", auto: "invisible", command: "title @p title {\"text\": \"Home\", \"color\": \"gold\"}", elevate_perms: true, silent: true }, { id: "4734069C9EF04CB5", type: "command", auto: "invisible", command: "execute at @p run playsound minecraft:ui.toast.challenge_complete master @p ~ ~ ~ 1 1", elevate_perms: true, silent: true }, { id: "0FC66C65776834C4", type: "toast", title: "Home", auto: "enabled", description: "Next: the door, the two windows, the bed and the sconce are in your bag. The holes they go in are already in the walls." }]
		}
		{
			id: "0778ACD6AAB0BFA3"
			title: "Hang the Door, Windows, Bed and Sconce"
			subtitle: "All four are in your bag. The holes are already there."
			icon: "handcrafted:oak_table"
			description: ["Josie: “A house is a box until somebody shuts a door in it. Go and shut the door.”", "", "The doorway is empty, two window holes are open to the weather, there is a wool mat where the bed goes and a hook by the door. Put the Oak Cottage Door in the doorway, one Oak Window in each hole, the Red Bed on the mat and the Sconce on the hook. Any order is right.", "", "The cottage becomes a home you can cook in, and the smoke from it is what brings Marnie up the hill."]
			x: 4.0d
			y: -0.8d
			dependencies: ["07A167074EA22047"]
			hide_until_deps_complete: false
			hide_details_until_startable: false
			tasks: [{ id: "7A1B25FC10DBBD8F", type: "checkmark", title: "Door, two windows, bed and sconce placed" }]
			rewards: [{ id: "6387ADDDA12E3432", type: "item", auto: "no_toast", item: "handcrafted:oak_table" }, { id: "5066404E3C808656", type: "item", auto: "no_toast", item: "handcrafted:oak_chair", count: 2 }, { id: "45B573E9C7E956F4", type: "item", auto: "no_toast", item: "farmersdelight:canvas_rug" }, { id: "25EA0F4368FD6EDA", type: "item", auto: "no_toast", item: "supplementaries:flower_box", count: 2 }, { id: "33EBDBA5AE0D0BD7", type: "item", auto: "no_toast", item: "farmersdelight:cooking_pot" }, { id: "7FF5D9F0E9834438", type: "item", auto: "no_toast", item: "minecraft:campfire" }, { id: "1ECCE32C959C2629", type: "item", auto: "no_toast", item: "minecraft:bricks", count: 16 }, { id: "5193D6C3689688C4", type: "item", auto: "no_toast", item: "farmersdelight:cabbage", count: 4 }, { id: "4FA5CED11522F9C9", type: "item", auto: "no_toast", item: "minecraft:carrot", count: 4 }, { id: "2721CFE734A6A227", type: "item", auto: "no_toast", item: "minecraft:potato", count: 4 }, { id: "7AAF77111AF4072C", type: "item", auto: "no_toast", item: "minecraft:beetroot", count: 4 }, { id: "76451AD07B0CFD03", type: "item", auto: "no_toast", item: "minecraft:beetroot_seeds", count: 4 }, { id: "632263481B7D960B", type: "toast", title: "Four Walls and a Door", auto: "enabled", description: "Next: place the Megatorch inside the cottage. Then the soup." }]
