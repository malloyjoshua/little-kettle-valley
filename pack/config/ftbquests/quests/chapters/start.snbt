		}
		{
			id: "0778ACD6AAB0BFA3"
			title: "Hang the Door, Windows, Bed and Sconce"
			subtitle: "All four are in your bag."
			icon: "handcrafted:oak_table"
			description: ["Josie: \"A house is a box until somebody shuts a door in it. Go and shut the door.\"", "", "Put the Oak Cottage Door in the doorway, one Oak Window in each of the two holes, the Red Bed on the wool mat, and the Sconce on the hook by the door. Any order is right.", "", "The cottage becomes a home you can cook in, and the smoke from it is what brings Marnie up the hill."]
			x: 4.0d
			y: -0.8d
			dependencies: ["07A167074EA22047"]
			hide_until_deps_complete: false
			hide_details_until_startable: false
