		}
		{
			id: "7B69878FA5D50650"
			title: "Drive the Surveyor's Stake into Bram's Socket"
			subtitle: "It is cut into the middle of the square. It has been for forty years."
			icon: "valley:town_anchor"
			description: ["Josie: “Bram surveyed that flat by the road twice, cut the socket for the stake, and never drove it — forty years of nearly. Drive it.”", "", "Walk up the road to the square. There is a chiselled socket in the paving two blocks north of the town waystone, with Bram's own sign beside it. Put the Surveyor's Stake in it.", "", "Nothing moves and nothing is built. The square, the streets and the empty houses round it have been standing since long before you got here — what changes is that the town is on the record again, and the two lamps at the head of the High Street come on."]
			x: 8.0d
			y: 0.0d
			dependencies: ["1DAA2A770D01CD6E"]
			min_width: 300
			hide_until_deps_complete: false
			hide_details_until_startable: false
			tasks: [{ id: "78D5ED0D9A81550E", type: "checkmark", title: "Surveyor's Stake driven into the socket on the square" }]
