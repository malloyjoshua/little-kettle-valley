		}
		{
			id: "2CA1AF8451E957EA"
			title: "Sleep One Night in Your Bed"
			subtitle: "Marnie sees the chimney."
			icon: "minecraft:red_bed"
			description: ["Marnie: “Four years I've looked at that chimney, and last night there was smoke. I've brought bread and I am not carrying it home.”", "", "Sleep one night in the Red Bed in your cottage.", "", "Marnie unlocks the inn she has kept with no guests in it and moves back in, Bram opens the mill, and she leaves you her seed sack, 32 Green Oak Planks and a flint and steel."]
