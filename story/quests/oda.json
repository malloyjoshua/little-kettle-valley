    "icon": "valley:scrip",
    "group": "Story",
    "order": 5
  },
  "quests": [
    {
      "key": "oda_open",
      "title": "Read Oda's Board at the Counter",
      "subtitle": "Scrip only. Every line restocks.",
      "icon": "valley:scrip",
      "description": [
        "Oda: \"Store's open. Shelves are thin and my ledger is thinner, but they're open. Cash is Scrip. I don't barter and I don't round up.\"",
        "",
        "Scrip comes from bounties, deliveries, festival baskets and closing a neighbour's story. Nothing else pays it and nothing else spends it.",
        "",
        "Every line below restocks. Buy a line as many times as you can pay for it."
      ],
      "deps": [
        "q19"
      ],
      "shape": "hexagon",
      "size": 1.5,
      "tasks": [
        {
          "type": "checkmark",
          "title": "Read the board and the prices under it"
        }
      ],
      "rewards": [
        {
          "type": "item",
          "item": "valley:catalogue",
          "count": 1
        },
        {
          "type": "item",
          "item": "valley:scrip",
          "count": 10
        },
        {
          "type": "command",
          "command": "/tellraw @p [{\"text\":\"Oda: \",\"color\":\"yellow\"},{\"text\":\"Ten Scrip on the house. That is the only time those four words happen in this store.\",\"color\":\"white\",\"italic\":true}]"
        },
        {
          "type": "toast",
          "title": "Oda's Counter is open",
          "description": "Scrip only. Every line restocks. Cheap tech first, decor when the rail comes in."
