{
  "_readme": [
    "Source of truth for the Copper Kettle Valley residents as Easy NPC 7.11.0 presets.",
    "Generated by tools/scripts/make_npc_presets.py into pack/kubejs/data/valley/easy_npc/preset/<key>.npc.snbt",
    "(plus an inert compat copy at pack/kubejs/data/valley/preset/<key>.npc.snbt -- see meta.path_warning).",
    "Do not hand-edit the .npc.snbt files. Edit this file and re-run the generator."
  ],
  "meta": {
    "namespace": "valley",
    "easy_npc_version": "7.11.0",
    "preset_root": "pack/kubejs/data/valley/easy_npc/preset",
    "compat_root": "pack/kubejs/data/valley/preset",
    "import_command": "/easy_npc preset import data valley:easy_npc/preset/<key>.npc.snbt <x> <y> <z>",
    "import_command_new": "/easy_npc preset import_new data valley:easy_npc/preset/<key>.npc.snbt <x> <y> <z>",
    "path_warning": "VERIFIED FROM THE JAR: de.markusbordihn.easynpc.security.PresetSecurity#isAllowedDataPresetPath accepts a data preset ONLY when its resource path starts with 'easy_npc/preset/' or 'easy_npc/api/preset/' (or, for the easy_npc namespace itself, 'preset/' / 'api/preset/'). A resource location of valley:preset/<name>.npc.snbt is REJECTED with 'Rejected data preset ..., because it is not below the expected ... folder.' The working location is valley:easy_npc/preset/<name>.npc.snbt. The compat copy under pack/kubejs/data/valley/preset/ is written only because the build brief named that path; it is inert and nothing should reference it.",
    "access_warning": "VERIFIED FROM THE JAR: PresetAccess#isUsableByCommand returns false for access:\"INTERNAL\". The jar's base humanoid template is INTERNAL, so every valley preset sets access:\"PUBLIC\" or it cannot be imported by command.",
    "open_book_warning": "VERIFIED FROM THE JAR: dev.ftb.mods.ftbquests.command.FTBQuestsCommands registers 'open_book' with an optional quest_object string argument and NO player argument; it opens the book for the command SOURCE player. 'ftbquests open_book @initiator' is therefore a syntax error. The action is written as Cmd:\"/ftbquests open_book\" with ExecAsUser:1b, which is exactly what pack/config/easy_npc/security.cfg already provisions: executeAsUserCommandAllowList.ALL=ftbquests,trigger,me.",
    "perm_level_note": "/info_message expands (ActionUtils.MACRO_INFO_MESSAGE) to /title @initiator title {\"text\":\"...\",\"color\":\"aqua\"}. Vanilla /title needs permission level 2, so the greeting actions carry PermLevel:2. PresetSanitizer clamps PermLevel to min(entry, actor level); a server/console import gets serverTrustedCommandLevel=ADMINS (3), so 2 survives. A survival player importing by hand would have it clamped to 0 and the greeting would silently do nothing -- always run the imports from a function, KubeJS, or an op console.",
    "uuid_note": "Each preset carries a deterministic data.UUID (uuid5 of 'valley:npc:<key>'). PresetHandler#importPresetData branches on that UUID: if an entity with it already exists it is updated in place, otherwise it is created. That is what makes 'preset import' idempotent and what makes re-importing a resident safe.",
    "arc_gating": {
      "mechanism": "SCOREBOARD condition on each ON_INTERACTION greeting action",
      "why": "PlayerTagCondition ignores the operation field entirely (it is a plain Set#contains), so a player tag cannot express the 'arc not closed yet' half of the pair. ScoreboardCondition honours ConditionOperationType, so one dummy objective per resident gives both halves.",
      "setup_commands": [
        "scoreboard objectives add valley_arc_marnie dummy",
        "scoreboard objectives add valley_arc_bram dummy",
        "scoreboard objectives add valley_arc_oda dummy",
        "scoreboard objectives add valley_arc_nella dummy",
        "scoreboard objectives add valley_arc_halden dummy",
        "scoreboard objectives add valley_arc_tobin dummy",
        "scoreboard objectives add valley_arc_wisp dummy",
        "scoreboard objectives add valley_arc_pip dummy"
      ],
      "setup_owner": "valley_core.js, on server load, before any resident is imported. If an objective is missing, ScoreboardCondition logs 'Scoreboard objective ... does not exist' and BOTH greeting lines stay hidden -- the NPC would still open the book but say nothing.",
      "close_reward": "The arc-closing quest adds a command reward: {\"type\":\"command\",\"command\":\"/scoreboard players set @p <objective> 1\",\"elevate\":true,\"silent\":true}"
    },
    "tag_note": "Tags[] round-trips because importPresetData builds the entity from the whole NBT compound. If a future Easy NPC build drops it, re-tag after import with: /tag @e[type=easy_npc:humanoid,limit=1,sort=nearest] add npc_<key>",
    "skin_note": "All skins are SkinData Type:\"DEFAULT\" with a VariantType from the jar's own enums (HumanoidSkinVariant: ALEX ARI EFE KAI MAKENA NOOR STEVE SUNNY ZURI JAYJASONBO PROFESSOR_01 SECURITY_01 KNIGHT_01 KNIGHT_02; HumanoidSlimSkinVariant: ALEX ARI EFE KAI MAKENA NOOR STEVE SUNNY ZURI KAWORRU). No PLAYER_SKIN, no remote URL: those need a network round trip and security.cfg gates URL_RESOURCE behind CREATIVE_PLAYER.",
    "on_interaction_template": {
      "_note": "Every resident's ON_INTERACTION list is exactly this shape. It is written out per NPC below in \"on_interaction\" so the generator never has to guess; edit it there, not here.",
      "greeting_before_arc": "{Type:COMMAND, Cmd:'/info_message <greeting>', ExecAsUser:0b, PermLevel:2, ConditionDataSet:[{Type:SCOREBOARD, Name:<objective>, Operation:LESS_THAN, Value:1}]}",
      "greeting_after_arc": "{Type:COMMAND, Cmd:'/info_message <greeting_after>', ExecAsUser:0b, PermLevel:2, ConditionDataSet:[{Type:SCOREBOARD, Name:<objective>, Operation:GREATER_THAN_OR_EQUALS, Value:1}]}",
      "greeting_ungated": "{Type:COMMAND, Cmd:'/info_message <greeting>', ExecAsUser:0b, PermLevel:2}  (NPCs with arc:null)",
      "open_book": "{Type:COMMAND, Cmd:'/ftbquests open_book', ExecAsUser:1b, PermLevel:0}  -- never conditional"
    }
  },
